{
  "name": "jera",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "bun scripts/check-client.mjs",
    "dev": "cd \"${JERA_BACKEND_DIR:-../jera-snapback}\" && npm run dev",
    "test": "node --test tests/*.test.mjs",
    "agent": "node scripts/agent.mjs",
    "release:iphone": "node scripts/release-iphone.mjs",
    "ios:check": "cd app && bun run ios:check",
    "ios:local": "cd app && bun run ios:local",
    "ios:archive": "cd app && bun run ios:archive",
    "web": "cd app && bun run web:live",
    "pretest": "node scripts/prepare-sdk.mjs",
    "test:app": "bun test ./app/*.test.ts",
    "test:integration": "node --test tests/views.integration.mjs"
  },
  "dependencies": {
    "snapback4": "0.4.33",
    "unicode-segmenter": "0.17.3"
  }
}
