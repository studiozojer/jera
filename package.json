{
  "name": "jera",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "snapback4 check",
    "dev": "snapback4 dev --port 4417",
    "test": "node --test tests/*.test.mjs auth/test/*.test.mjs",
    "agent": "node scripts/agent.mjs",
    "ios:check": "cd app && bun run ios:check",
    "ios:local": "cd app && bun run ios:local",
    "ios:archive": "cd app && bun run ios:archive",
    "web": "cd app && bun run web:live",
    "pretest": "node scripts/prepare-sdk.mjs",
    "test:app": "bun test ./app/*.test.ts"
  },
  "dependencies": {
    "snapback4": "0.4.33"
  }
}
