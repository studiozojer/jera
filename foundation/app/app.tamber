tamber jera

// daoUI tokens.json: bg.base aliases bg/solid/base. Alpha is preserved.
theme
  bg.base = light-dark(#FAF9F6, #1A1714)
  bg.field = light-dark(#3D403B14, #F3F6F814)
  bg.card = light-dark(#F7F3EC, #2C2721)
  bg.hover = light-dark(#EFE9DF, #342F2A)
  bg.pressed = light-dark(#E7DFD3, #3C3832)
  tx.primary = light-dark(#191B18, #FEFFFFF2)
  tx.secondary = light-dark(#3D403BBF, #F3F6F8B3)
  tx.warning = light-dark(#F18736F2, #F18736F2)
  bd.primary = light-dark(#3D403B26, #F3F6F826)

icons
  icon.login-desktop = icon(svg "icons/login-desktop.svg")
  icon.login-touch = icon(svg "icons/login-touch.svg")
