fresh
epoch now
size 390x844

test "ordinary writing inherits Private without configuration controls"
  fail fetch "https://public.api.bsky.app/"
  type "handle" "owner.test"
  clock data
  tap "login"
  authorize
  clock settle
  tap "feed-write"
  clock settle
  expect tree missing "composer-format"
  expect tree missing "composer-audience"
  expect tree missing "field-purpose"
  expect tree missing "experience-private"
  type "composer" "A simple thought ♍︎ ♍️"
  clock settle
  screenshot ".exact/composer-simple-narrow.png"
  resize 1100x850
  screenshot ".exact/composer-simple-wide.png"
  resize 390x844
  tap "cancel"
  reload
  clock settle
  tap "feed-write"
  clock settle
  expect text "composer" == "A simple thought ♍︎ ♍️"
  tap "post"
  clock settle
  expect state posts.length == 1
  expect state posts.0 .body == "A simple thought ♍︎ ♍️"


test "an existing structured draft retains its context and fields"
  request POST "/dev/structured-draft" {}
  fail fetch "https://public.api.bsky.app/"
  type "handle" "owner.test"
  clock data
  tap "login"
  authorize
  clock settle
  tap "feed-write"
  clock settle
  clock +1000
  clock data
  expect state editorFormat == "contribution.v1"
  expect tree missing "composer-format"
  expect tree missing "composer-audience"
  expect text "saved-audience" == "Only me"
  expect state editorFields.0 .value == "reflect"
  expect text "reference-0-uri" == "repo:notes/north-star.yao"
  expect text "reference-0-revision" == "abc123"
  type "field-purpose" "archive"
  clock settle
  tap "cancel"
  reload
  clock settle
  tap "feed-write"
  clock settle
  expect state editorFields.0 .value == "archive"
  expect text "reference-0-uri" == "repo:notes/north-star.yao"
  screenshot ".exact/composer-recovered.png"
  tap "post"
  clock settle
  expect state posts.length == 1
  expect state posts.0 .purpose == "archive"
  expect state posts.0 .audienceLabel == "Only me"
  expect state posts.0 .references.0 .revision == "abc123"
  tap "reply"
  clock settle
  expect tree missing "field-purpose"
  type "composer" "A plain reply in the same audience."
  tap "post"
  clock settle
  expect state posts.length == 2
