{
  "$schema": "../../tooling/exact2/scripts/app.schema.json",
  "name": "Jera",
  "short_name": "Jera",
  "id": "studio.zojer.jera.exact",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "studio.zojer.jera.exact",
    "name": "Jera"
  },
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 900,
        "height": 700
      }
    },
    "web": {}
  },
  "deploy": {
    "store": {
      "web": "0",
      "macos": "0",
      "ios": "0",
      "linux": "0"
    }
  },
  "typescript": {
    "sources": {
      "snapback4": "../../tooling/exact2/snapback4/ts",
      "backend": "../snapback/generated"
    }
  },
  "commands": {
    "server": [
      "bun",
      "test-server-launch.mjs"
    ]
  },
  "server": {
    "database": false
  },
  "icons": [
    {
      "src": "assets/icon.png",
      "sizes": "1024x1024",
      "type": "image/png"
    }
  ],
  "verify": {
    "accept": [
      {
        "finding": "broken-words",
        "node": "account-did",
        "why": "A DID is one opaque identifier, not prose. Allow visual line breaks without inserting characters or reducing Dynamic Type; the full value remains intact."
      },
      {
        "finding": "overlap",
        "node": "signin-invitation",
        "why": "The account suggestions intentionally float in an opaque top-layer popover. At large text sizes it can flip above the input and cover the invitation; the text does not paint through. Verified with real browser screenshots, outside-click dismissal and Escape."
      }
    ]
  }
}
