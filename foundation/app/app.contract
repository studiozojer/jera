use ExperienceSnapshot, ExperienceModeControl from "./experience.contract"
use JeraWordmark from "./brand.contract"
use AccountAvatar, AccountRow, LoginButton, SignInFAQ from "./signin.contract"
use spaceSm, spaceMd, spaceLg, spaceXl, spaceXxl, radiusMd, radiusFull, minTouchTarget from "./dao.contract"
use WhyteSm, WhyteXs, WhyteMd, QuietAction from "./dao.contract"
use Button, Action from "./dao/actions.contract"
use Post, Author, PostAvatar, PostActions, canReplyInExperience from "./post.contract"
use ReadingHeader, ThreadHeader, WriteButton, FeedComposer from "./chrome.contract"
use ThreadHero, ThreadBranch, ThreadReplyEntry from "./thread.contract"

font "Whyte" = "assets/fonts/ABCWhyteEdu-Book.otf"
font "Whyte Inktrap" = "assets/fonts/ABCWhyteInktrap-Regular.otf"
font "Fraktion Mono" = "assets/fonts/PPFraktionMono-Regular.otf"

routes nav
  home "/"
    account "/account"
    thread "/thread/:id"
    compose "/write"
    audience "/audience"

shape Viewport
  pointer: string
  width: number
shape Page
  navigationType: string
  visibilityState: string
shape Profile
  principal: string
  name: string
  handle: string
  avatar: string
shape Clock
  epochAtZero: number
shape Account
  principal: string
shape LoginInput
  input: string
  value: string
  valid: bool
shape AccountSuggestion
  did: string
  handle: string
  displayName: string
  avatar: string
shape AccountSuggestions
  query: string
  items: AccountSuggestion[]
  available: bool
  complete: bool
shape Ack
  state: string
  id: string
shape Timeline
  available: bool
  principal: string
  posts: Post[]
shape Published
  state: string
  id: string
  parent: string
  principal: string
  visibility: string
  message: string
shape SavedDraft
  principal: string
  scope: string
  body: string
  revision: number
  pendingMode: string
shape CloudDraft
  principal: string
  scope: string
  body: string
  revision: number
  priorRevision: number
  state: string
shape AudienceMember
  principal: string
  access: string
shape Audience
  available: bool
  principal: string
  id: string
  members: AudienceMember[]

style ManagementButton
  background-color = "bg.card"
  :hover
    background-color = "bg.hover"
  :active
    background-color = "bg.pressed"
  :disabled
    color = "tx.secondary"

component App
  task defaultTheme mount
    after(1, applyDefaultTheme)
  action applyDefaultTheme
    setScheme("dark")
  resource viewport = exactViewport() as shape Viewport
  resource page = exactPage() as shape Page
  state handle = ""
  resource loginInput = loginInput(handle) as shape LoginInput else empty()
  derive canSubmit = loginInput.input == handle and loginInput.valid and not pending(loginInput) and not pending(signed)
  state accountQuery = ""
  state selectedHandle = ""
  state accountsOpen = false
  resource suggestions = lookupAccounts(accountQuery) as shape AccountSuggestions else empty()
  task searchAccounts when account.principal == "" and handle.trim() != accountQuery and handle != selectedHandle key=handle
    after(250, searchAccounts)
  action searchAccounts
    accountQuery = handle.trim()
  action suggestionsToggled(e: ToggleEvent)
    accountsOpen = e.newState == "open"
  action openSuggestions
    if handle.trim().length >= 2 and not handle.trim().startsWith("did:") and handle != selectedHandle
      showPopover("account-suggestions", source="account-entry")
  action accountKey(k: string)
    if k == "Escape"
      preventDefault()
      hidePopover("account-suggestions")
    if k == "ArrowDown" and suggestions.items.length > 0 and suggestions.query == handle.trim()
      preventDefault()
      showPopover("account-suggestions", source="account-entry")
      focus("suggestion-0")
  action chooseAccount(value: string)
    hidePopover("account-suggestions")
    handle = value
    selectedHandle = value
    accountQuery = ""
    focus("account-handle")
  action suggestionKey(i: number, k: string)
    if k == "Escape"
      preventDefault()
      hidePopover("account-suggestions")
      focus("account-handle")
    if k == "ArrowDown" and i + 1 < suggestions.items.length
      preventDefault()
      focus(`suggestion-${i + 1}`)
    if k == "ArrowUp"
      preventDefault()
      if i == 0
        focus("account-handle")
      else
        focus(`suggestion-${i - 1}`)
  resource time = exactTime() as shape Clock
  resource account = restore(page.navigationType != "") with time.epochAtZero as shape Account else empty()
  resource profile = accountProfile(account.principal) as shape Profile else empty()
  derive profileReady = profile.principal == account.principal
  derive profileName = profileReady and profile.name != "" ? profile.name : "Your account"
  derive profileAvatar = profileReady ? profile.avatar : ""
  derive profileHandle = profileReady ? profile.handle : ""
  mutation signed as shape Ack refreshes account then afterAuth
  mutation signedOut as shape Ack refreshes account then afterLogout
  derive compact = viewport.width < 704
  state feedHeaderHeight = 0
  state threadHeaderHeight = 0
  resource experienceState = experienceSnapshot(account.principal) as shape ExperienceSnapshot else empty()
  mutation experienceChanged as shape ExperienceSnapshot refreshes experienceState then afterExperienceChange
  derive currentExperience = match experienceChanged { case some(s) => s.principal == account.principal and s.revision >= experienceState.revision ? s : experienceState, case none => experienceState }
  derive mode = currentExperience.principal == account.principal and currentExperience.mode == "public" ? "public" : "private"
  task experienceTheme when currentExperience.principal == account.principal key=`${account.principal}-${mode}`
    after(1, applyExperienceTheme)
  action applyExperienceTheme
    setMode("experience", account.principal == "" ? "public" : mode)
  state dataNow = 0
  task initializeDataClock mount
    after(1, sampleDataClock)
  task updateDataClock when account.principal != "" and page.visibilityState == "visible"
    every(10000, sampleDataClock)
  action sampleDataClock
    dataNow = time.epochAtZero + performanceNow()
  resource timeline = loadPosts(account.principal, page.navigationType != "", dataNow) as shape Timeline else empty()
  derive posts = timeline.principal == account.principal ? timeline.posts : []
  derive visiblePosts = posts.filter(p => p.visibility == "public" or mode == "private")
  derive feedPosts = sortBy(posts.filter(p => p.visibility == mode and (p.parent == "" or (mode == "private" and p.parentPublic))), p => p.at, "desc")
  state replyTo = ""
  state composeContextChanged = false
  state lastPosted = ""
  derive privateReply = posts.filter(p => p.id == replyTo and p.visibility == "private").length > 0
  derive scope = replyTo == "" ? `root:${mode}` : `reply:${replyTo}`
  derive editorKey = `${account.principal}|${scope}`
  state editorContext = ""
  state editorText = ""
  state editRevision = 0
  derive draft = editorContext == editorKey ? editorText : ""
  resource savedDraft = loadDraft(account.principal, mode, replyTo) as shape SavedDraft else empty()
  derive draftReady = savedDraft.principal == account.principal and savedDraft.scope == scope and not failed(savedDraft)
  derive pendingDraft = draftReady and savedDraft.pendingMode != ""
  mutation draftSaved as shape SavedDraft queue refreshes savedDraft
  mutation cloudSynced as shape CloudDraft refreshes savedDraft then afterCloudSync
  mutation draftsSynced as shape Ack
  task syncEditingDraft when top(nav).name == "compose" and account.principal != "" and editorContext == editorKey and draftReady and not pending(draftSaved) and not pending(published) and not pendingDraft key=`${editorKey}|${editRevision}`
    after(800, syncCurrentDraft)
  action syncCurrentDraft
    send cloudSynced = syncDraft(account.principal, mode, replyTo, time.epochAtZero + performanceNow(), page.navigationType != "")
  action afterCloudSync
    match cloudSynced
      case some(result)
        if result.principal == account.principal and result.scope == scope and editorContext == editorKey and editRevision == result.priorRevision and result.body != editorText
          editorText = result.body
          editRevision = result.revision
      case none
        editorContext = editorContext
  task syncPrivateDrafts when account.principal != "" and page.visibilityState == "visible" and not pending(draftsSynced)
    every(15000, syncSavedDrafts)
  action syncSavedDrafts
    send draftsSynced = syncAllDrafts(account.principal, time.epochAtZero + performanceNow(), page.navigationType != "")
  mutation published as shape Published refreshes timeline, savedDraft then afterPost
  task hydrate when account.principal != "" and draftReady and editorContext != editorKey key=editorKey
    after(1, hydrateEditor)
  action hydrateEditor
    editorText = savedDraft.body
    editRevision = savedDraft.revision
    editorContext = editorKey
    if savedDraft.pendingMode != "" and savedDraft.pendingMode != mode
      send experienceChanged = changeExperience(account.principal, savedDraft.pendingMode, time.epochAtZero + performanceNow())
  action refreshPosts
    refresh timeline
  action selectExperience(value: string)
    if value != mode and not pending(experienceChanged) and not pending(published) and not pendingDraft and (top(nav).name != "compose" or replyTo == "" or canReplyInExperience(posts, replyTo, value))
      if top(nav).name != "compose"
        replyTo = ""
      send experienceChanged = changeExperience(account.principal, value, time.epochAtZero + performanceNow())
  action afterExperienceChange
    composeContextChanged = true
  action follow(url: string)
    nav = top(nav).name == "compose" and composeContextChanged and url != "/write" ? (replyTo == "" ? go(nav, "/") : push(go(nav, "/"), path("thread", replyTo))) : go(nav, url)
  action openThread(id: string)
    nav = push(nav, path("thread", id))
  action dismiss
    nav = top(nav).name == "compose" and composeContextChanged ? (replyTo == "" ? go(nav, "/") : push(go(nav, "/"), path("thread", replyTo))) : back(nav)
  action write
    composeContextChanged = false
    replyTo = ""
    nav = push(nav, "/write")
  action reply(id: string)
    composeContextChanged = false
    replyTo = id
    nav = push(nav, "/write")
  action edit(value: string)
    let revision = editRevision + 1
    editorText = value
    editRevision = revision
    send draftSaved = saveDraft(account.principal, mode, replyTo, value, revision)
  action saveCurrentDraft
    let revision = editRevision + 1
    editRevision = revision
    send draftSaved = saveDraft(account.principal, mode, replyTo, editorText, revision)
  action retryDraft
    refresh savedDraft
  action post
    if draft.trim() != "" and not pending(published) and not pending(draftSaved) and not failed(draftSaved) and editorContext == editorKey and (replyTo == "" or canReplyInExperience(posts, replyTo, mode))
      send published = publishPost(account.principal, mode, replyTo, editRevision, time.epochAtZero + performanceNow(), page.navigationType != "")
  action afterPost
    match published
      case some(result)
        if result.state == "sent" and result.principal == account.principal
          editorText = ""
          editorContext = ""
          let previous = composeContextChanged ? go(nav, "/") : back(nav)
          nav = result.parent == "" ? push(previous, path("thread", result.id)) : (top(previous).params.id == result.parent ? previous : push(previous, path("thread", result.parent)))
          lastPosted = result.id
      case none
        lastPosted = ""
  task revealPosted when lastPosted != "" and top(nav).name == "thread" and posts.filter(p => p.id == lastPosted).length > 0 key=lastPosted
    after(1, revealPost)
  action revealPost
    scrollIntoView(`thread-${top(nav).id}-${lastPosted}`, block="nearest")
    lastPosted = ""
  action measureFeedHeader(w: number, h: number)
    if h > 0
      feedHeaderHeight = h + (compact ? 0 : spaceSm())
  action measureThreadHeader(w: number, h: number)
    if h > 0
      threadHeaderHeight = h + (compact ? 0 : spaceSm())
  state audienceDid = ""
  resource audience = loadAudience(account.principal, page.navigationType != "", dataNow) as shape Audience else empty()
  mutation audienceGranted as shape Ack refreshes audience, timeline then afterAudienceGrant
  mutation audienceRevoked as shape Ack refreshes audience, timeline
  action openAudience
    nav = push(back(nav), "/audience")
  action editAudienceDid(value: string)
    audienceDid = value
  action addAudienceMember
    if audienceDid.trim() != "" and not pending(audienceGranted)
      send audienceGranted = grantAudience(account.principal, audienceDid, time.epochAtZero + performanceNow(), page.navigationType != "")
  action afterAudienceGrant
    audienceDid = ""
  action removeAudienceMember(did: string)
    if audience.principal == account.principal and not pending(audienceRevoked)
      send audienceRevoked = revokeAudience(account.principal, audience.id, did, time.epochAtZero + performanceNow(), page.navigationType != "")
  action openAccount
    nav = push(nav, "/account")
  action closeAccount
    nav = back(nav)
  action logout
    send signedOut = logout(time.epochAtZero + performanceNow(), page.navigationType != "")
  action afterLogout
    nav = go(nav, "/")
    replyTo = ""
    lastPosted = ""
    editorText = ""
    editorContext = ""
    handle = ""
    selectedHandle = ""
    accountQuery = ""
  action retryAccount
    refresh account
  action afterAuth
    accountQuery = ""
    selectedHandle = handle
  action editHandle(v: string)
    handle = v
    selectedHandle = ""
    accountQuery = ""
    if v.trim().length >= 2 and not v.trim().startsWith("did:")
      showPopover("account-suggestions", source="account-entry")
    else
      hidePopover("account-suggestions")
  action login
    if canSubmit
      hidePopover("account-suggestions")
      send signed = login(handle, time.epochAtZero + performanceNow())
  view
    main status-bar-style="light-content" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" color-scheme="dark" font-family="Whyte" background-color=(account.principal == "" ? "bg.base" : "experience.canvas") color="tx.primary" interactive-widget="resizes-content" display="flex" flex-direction="column"
      for entry in stack(nav) key=entry.id
        if entry.name == "home"
          column navigationKey=`${entry.id}` navigationBar="none" position="absolute" inset=0 box-sizing="border-box"
            if account.principal == ""
              header appearance="none" border-width=0 padding="32px"
                JeraWordmark(scale=2)
            if account.principal != ""
              scroll id="stream" testId="stream" aria-label=(mode == "private" ? "Private posts" : "Public posts") tabindex=0 flex=1 min-height=0 width="100%" overflow-y="auto" overflow-x="hidden"
                column min-height="100%"
                  ReadingHeader(account=openAccount, avatar=profileAvatar, name=profileName, compact=compact, measure=measureFeedHeader, mode=mode, changeExperience=selectExperience, switchDisabled=(pending(published) or pendingDraft), touch=(viewport.pointer == "coarse"))
                  column flex=1 min-height=0 width="100%" max-width="44rem" margin="0 auto" box-sizing="border-box" padding-right=(compact ? 0 : spaceMd()) padding-left=(compact ? 0 : spaceMd())
                    column flex=1 border-left-width=(compact ? 0 : 1) border-right-width=(compact ? 0 : 1) border-left-style="solid" border-right-style="solid" border-color="bd.primary" padding-bottom=(compact ? "5rem" : "6rem")
                      FeedComposer(write=write, avatar=profileAvatar, name=profileName)
                      for item, index in feedPosts key=item.id
                        article press=openThread(item.id) role="link" aria-label=`Open thread by ${item.author}: ${item.body.slice(0, 64)}` tabindex=0 testId=`post-row-${item.id}` class=Action border-radius=0 scroll-margin-top=(feedHeaderHeight + spaceSm()) padding-top=spaceMd() padding-bottom=spaceMd() padding-left=spaceLg() padding-right=spaceLg() border-top-width=(index == 0 ? 0 : 1) border-top-style="solid" border-top-color="bd.primary" display="flex" flex-direction="column" gap=spaceSm()
                          :hover
                            background-color="transparent"
                          row gap=spaceMd() align-items="flex-start" flex-wrap="wrap"
                            PostAvatar(post=item)
                            column flex=1 flex-basis="12rem" min-width=0 gap="dao.space.xs"
                              // Clear the menu's full touch target without widening action gaps.
                              column gap=spaceMd()
                                Author(post=item, menuId=`stream-menu-${item.id}`, clearance=(feedHeaderHeight + spaceSm()))
                                column gap="dao.space.xs"
                                  if item.parent != ""
                                    text `Private reply to ${item.parentAuthor}` class=WhyteXs color="tx.secondary"
                                  text item.body class=WhyteSm white-space="pre-wrap" testId=`body-${item.id}`
                              PostActions(post=item, comments=(mode == "public" ? item.publicReplies : item.readableReplies), comment=openThread(item.id), commentId=`thread-${item.id}`, commentLabel="Open conversation", context=`stream-${item.id}`, clearance=(feedHeaderHeight + spaceSm()))
                      if feedPosts.length == 0 and timeline.available and not pending(timeline) and not failed(timeline)
                        text "Nothing here yet." color="tx.secondary" class=WhyteSm padding=spaceXxl()
                      if failed(timeline) or (timeline.principal == account.principal and not timeline.available and not pending(timeline))
                        column padding=spaceLg() gap=spaceSm()
                          text "Couldn’t load posts." color="tx.secondary" class=WhyteSm
                          Button(controlId="", label="Try again", kind="ghost", size="medium", icon=none, disabled=false, busy=pending(timeline), press=refreshPosts, testId="retry-posts")
                      box height="env(safe-area-inset-bottom)" flex-shrink=0
              WriteButton(write=write, compact=compact)
            if account.principal == "" and not pending(account)
              scroll flex=1 min-height=0
                column padding="48px 24px 24px" gap=16 max-width="44rem" margin="0 auto" width="100%" box-sizing="border-box"
                  if failed(account)
                    text "Could not restore your session." color="-exact-system-red"
                    button "Try again" press=retryAccount testId="retry-account"
                  if failed(signed)
                    text (match failure(signed) { case some(f) => f.message, case none => "" }) testId="auth-error" color="-exact-system-red"
                  column gap=0
                    text "Join the cycle." font="-exact-title1" font-size="2rem" role="heading" aria-level=2 font-family="Whyte Inktrap" font-weight=400
                    text "Log in with your everything account, and bring your tokens into the network" testId="signin-invitation" color="tx.secondary" margin-top=16 max-width="24rem" line-height=1.5
                    row id="account-entry" testId="account-entry" gap=8 margin-top=32 align-items="stretch" width="100%" max-width="23.5rem"
                      input id="account-handle" value=handle input=editHandle submit=login press=openSuggestions key=accountKey aria-label="ATproto handle or DID" aria-controls="account-suggestions" aria-expanded=accountsOpen placeholder="Name, handle or DID" testId="handle" font-family="Whyte" autocomplete="username" autocapitalize="none" spellcheck=false enterkeyhint="go" appearance="none" flex=1 min-width=0 padding="12px" border-width=1 border-style="solid" border-color="bd.primary" border-radius=8 background-color="bg.field" color="tx.primary" font-size="1rem"
                      button press=login disabled=(not canSubmit) testId="login" aria-label="Continue with ATproto" title="Continue with ATproto" appearance="none" class=LoginButton width="3rem" min-height="3rem" box-sizing="border-box" flex-shrink=0 padding=12 border-radius=8 display="flex" align-items="center" justify-content="center"
                        if pending(signed)
                          image "symbol:refresh" aria-hidden=true
                        else
                          image (not canSubmit ? "symbol:icon.login-disabled" : viewport.pointer == "coarse" ? "symbol:icon.login-touch" : "symbol:icon.login-desktop") aria-hidden=true font-size="1.5rem"
                    column id="account-suggestions" testId="account-suggestions" popover="auto" toggle=suggestionsToggled role="group" aria-label="Account suggestions" position="absolute" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline" margin="8px 0" width="min(376px, calc(100vw - 48px))" max-height="min(352px, 50vh)" overflow-y="auto" box-sizing="border-box" padding=6 gap=2 background-color="bg.card" color="tx.primary" border-width=0 border-radius=10 box-shadow="0 8px 24px #00000033"
                      if pending(suggestions) or accountQuery != handle.trim()
                        text "Looking for accounts…" padding=12 font="-exact-footnote" color="tx.secondary" aria-live="polite"
                      if accountQuery == handle.trim() and suggestions.query == accountQuery and not pending(suggestions)
                        if failed(suggestions) or not suggestions.available
                          text "Suggestions unavailable. You can still enter your full handle or DID." padding=12 font="-exact-footnote" color="tx.secondary" testId="suggestions-error"
                        else
                          if suggestions.items.length > 0
                            for person, i in suggestions.items key=person.did
                              button id=`suggestion-${i}` press=chooseAccount(person.handle) key=suggestionKey(i) appearance="none" class=AccountRow testId=`suggestion-${i}` aria-label=`Use @${person.handle}` padding=8 border-width=0 border-radius=6 color="tx.primary" text-align="left"
                                row gap=12 align-items="center" min-width=0 flex-wrap="wrap"
                                  AccountAvatar(src=person.avatar, label=(person.displayName != "" ? person.displayName : person.handle), size="2.5rem", radius=6)
                                  column gap=2 min-width=0 flex="1 1 12rem" align-items="flex-start"
                                    text (person.displayName != "" ? person.displayName : person.handle) font-family="Whyte" text-align="left"
                                    text `@${person.handle}` font-family="Whyte" font="-exact-footnote" color="tx.secondary" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="100%" text-align="left"
                          else
                            text "No matching account found. You can still enter your full handle or DID." padding=12 font="-exact-footnote" color="tx.secondary" testId="suggestions-empty"
                    SignInFAQ()
        if entry.name == "thread" and account.principal != ""
          column navigationKey=`${entry.id}` navigationBar="none" position="absolute" inset=0 box-sizing="border-box"
            scroll id="conversation" testId="conversation" aria-label="Conversation" tabindex=0 flex=1 min-height=0 width="100%" overflow-y="auto" overflow-x="hidden"
              column min-height="100%"
                ThreadHeader(back=dismiss, compact=compact, measure=measureThreadHeader, mode=mode)
                column width="100%" max-width="44rem" margin="0 auto" box-sizing="border-box" padding-right=(compact ? 0 : spaceMd()) padding-left=(compact ? 0 : spaceMd()) padding-bottom=(compact ? "5rem" : "6rem")
                  column flex-shrink=0 border-left-width=(compact ? 0 : 1) border-right-width=(compact ? 0 : 1) border-bottom-width=(compact ? 0 : 1) border-left-style="solid" border-right-style="solid" border-bottom-style="solid" border-color="bd.primary" border-bottom-left-radius=(compact ? 0 : radiusFull()) border-bottom-right-radius=(compact ? 0 : radiusFull()) testId="thread-frame"
                    if visiblePosts.filter(p => p.id == entry.params.id).length == 0 and timeline.available and not pending(timeline) and not failed(timeline)
                      text "Conversation unavailable." class=WhyteSm color="tx.secondary" padding=spaceXxl() testId="thread-unavailable"
                    if failed(timeline) or (timeline.principal == account.principal and not timeline.available and not pending(timeline))
                      Button(controlId="", label="Try loading again", kind="ghost", size="medium", icon=none, disabled=false, busy=pending(timeline), press=refreshPosts, testId="retry-thread")
                    for focused in visiblePosts.filter(p => p.id == entry.params.id) key=focused.id
                      if focused.parent != ""
                        for parent in visiblePosts.filter(p => p.id == focused.parent) key=parent.id
                          button press=openThread(parent.id) testId="parent-thread" appearance="none" class=QuietAction scroll-margin-top=(threadHeaderHeight + spaceSm()) min-height=minTouchTarget() padding-left=spaceLg() padding-right=spaceLg() border-width=0 background-color="transparent" text-align="left"
                            text `Replying to ${parent.author}` color="tx.secondary" class=WhyteXs
                      ThreadHero(post=focused, posts=visiblePosts, reply=reply, mode=mode, context=`${entry.id}`, clearance=(threadHeaderHeight + spaceSm()))
                      ThreadReplyEntry(post=focused, reply=reply, avatar=profileAvatar, name=profileName, clearance=(threadHeaderHeight + spaceSm()))
                      for child in visiblePosts.filter(p => p.parent == focused.id) key=child.id
                        ThreadBranch(post=child, posts=visiblePosts, mode=mode, reply=reply, open=openThread, context=`${entry.id}`, clearance=(threadHeaderHeight + spaceSm()))
                  box height="env(safe-area-inset-bottom)" flex-shrink=0
            WriteButton(write=write, compact=compact)
        if entry.name == "compose" and account.principal != ""
          column navigationKey=`${entry.id}` navigationBar="none" navigationPresentation="modal" navigationDetent="fit-content" navigationGrabber="visible" position="absolute" inset=0 background-color="experience.canvas" color="tx.primary" font-family="Whyte" padding=spaceXxl() gap=spaceXxl() box-sizing="border-box" overflow-y="auto"
            row align-items="center" justify-content="space-between" gap=spaceLg() flex-wrap="wrap"
              Button(controlId="back", label="Cancel", kind="ghost", size="medium", icon=none, disabled=pending(published), busy=false, press=dismiss, testId="cancel")
              text (replyTo == "" ? "New post" : "Reply") role="heading" aria-level=1 font-family="Whyte Inktrap" font-weight=400 class=WhyteMd
              Button(controlId="", label=(pendingDraft ? "Retry" : "Post"), kind="primary", size="medium", icon=none, disabled=(draft.trim() == "" or pending(experienceChanged) or pending(draftSaved) or failed(draftSaved) or editorContext != editorKey), busy=pending(published), press=post, testId="post")
            if privateReply
              text "Private" class=WhyteXs color="tx.secondary" aria-label="Reply visibility: Private" testId="reply-private-only"
            else
              ExperienceModeControl(idPrefix="experience", label="Post visibility", mode=mode, change=selectExperience, disabled=(pending(published) or pendingDraft), touch=(viewport.pointer == "coarse"))
            if failed(savedDraft)
              text "Couldn’t restore this draft. Existing data was kept." class=WhyteSm color="tx.secondary" role="status" testId="draft-load-error"
              Button(controlId="", label="Try again", kind="ghost", size="medium", icon=none, disabled=false, busy=false, press=retryDraft, testId="retry-draft-load")
            if failed(draftSaved)
              text "Couldn’t save your draft. Try again before posting." class=WhyteSm color="tx.secondary" role="status" testId="draft-save-error"
              Button(controlId="", label="Save draft", kind="ghost", size="medium", icon=none, disabled=false, busy=pending(draftSaved), press=saveCurrentDraft, testId="retry-draft-save")
            match cloudSynced
              case some(result)
                if result.principal == account.principal and result.scope == scope and result.state == "pending"
                  text "Draft saved on this device. Sync will retry." class=WhyteXs color="tx.secondary" role="status"
              case none
                box display="none"
            if pendingDraft and not pending(published)
              text "Couldn’t confirm this post yet. Retry safely with the same saved draft." class=WhyteSm color="tx.secondary" role="status" testId="post-pending"
            if failed(published)
              text "Couldn’t post. Your draft is kept." class=WhyteSm color="tx.secondary" role="status" testId="post-error"
            match published
              case some(result)
                if result.principal == account.principal and result.state == "failed"
                  text result.message class=WhyteSm color="tx.secondary" role="status"
              case none
                box display="none"
            if failed(experienceChanged)
              text "Couldn’t switch experiences. Try again." class=WhyteSm color="tx.secondary" role="status"
            if replyTo != ""
              for recipient in visiblePosts.filter(p => p.id == replyTo) key=recipient.id
                column gap=spaceSm() border-left="1px solid bd.primary" padding-left=spaceMd()
                  text `Replying to ${recipient.author}` color="tx.secondary" class=WhyteXs testId="reply-recipient"
                  text recipient.body class=WhyteSm white-space="pre-wrap" line-clamp=3 testId="reply-context"
            textarea id="composer" maxlength=12000 disabled=(pending(experienceChanged) or pending(published) or pendingDraft or editorContext != editorKey) value=draft input=edit placeholder=(replyTo == "" ? "What's on your mind?" : "Continue the conversation…") aria-label=(replyTo == "" ? "Write a post" : "Write a reply") testId="composer" outline="none" rows=8 min-height=224 width="100%" box-sizing="border-box" padding-top=spaceSm() padding-bottom=spaceSm() border-width=0 background-color="transparent" color="tx.primary" font-family="Whyte" class=WhyteSm resize="none"
        if entry.name == "account"
          // UIKit owns the sheet, including its safe area and interactive dismissal.
          // Web uses the dao-panel adapter for the same compact/regular presentation.
          column id="account-sheet" navigationKey=`${entry.id}` navigationBar="none" navigationPresentation="modal" navigationDetent="fit-content" navigationGrabber=(viewport.width < 768 ? "visible" : "hidden") closedby="any" hatch="dao-panel" aria-label="Your account" testId="account-sheet" position="absolute" inset=0 overflow-y="auto" border-radius=24 background-color="bg.base" color="tx.primary" font-family="Whyte"
            button id="account-dismiss" press=closeAccount aria-label="Dismiss account menu" testId="account-dismiss" display="none" width=44 height=28
            column gap=24 min-height="14rem" padding="32px 24px 24px" box-sizing="border-box"
              row gap=16 align-items="center" flex-wrap="wrap"
                for owner in [account.principal] key=owner
                  AccountAvatar(src=profileAvatar, label=profileName, size="3.5rem", radius=8)
                column gap=2 min-width=0 flex="1 1 10rem"
                  text profileName role="heading" aria-level=2 font-size="1.25rem" font-weight=400 max-width="100%" overflow="hidden" text-overflow="ellipsis" testId="profile-name"
                  if profileHandle != ""
                    text `@${profileHandle}` color="tx.secondary" max-width="100%" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="profile-handle"
              Button(controlId="", label="Private audience", kind="ghost", size="medium", icon=none, disabled=false, busy=false, press=openAudience, testId="private-audience")
              button "Log out" press=logout disabled=pending(signedOut) aria-busy=pending(signedOut) testId="logout" appearance="none" class=ManagementButton width="100%" box-sizing="border-box" min-height=52 padding="14px 16px" border-width=0 border-radius=8 color="tx.primary" font-family="Whyte" font-size="1.125rem"
              if failed(signedOut)
                text "Could not log out. Please try again." role="status" color="tx.secondary"
        if entry.name == "audience" and account.principal != ""
          column navigationKey=`${entry.id}` navigationBar="none" position="absolute" inset=0 background-color="experience.canvas"
            row padding=spaceLg() gap=spaceMd() align-items="center" flex-wrap="wrap"
              Button(controlId="back", label="Back", kind="ghost", size="medium", icon=none, disabled=false, busy=false, press=dismiss, testId="audience-back")
              text "Private audience" class=WhyteMd role="heading" aria-level=1 min-width=0 flex=1 flex-basis="8rem"
            scroll flex=1 min-height=0
              column padding=spaceLg() gap=spaceLg() width="100%" max-width="44rem" margin="0 auto" box-sizing="border-box"
                text "Choose who can read and reply to your private posts. Changes apply to existing posts too." class=WhyteSm color="tx.secondary"
                row gap=spaceSm() align-items="center" flex-wrap="wrap"
                  input value=audienceDid input=editAudienceDid submit=addAudienceMember placeholder="did:plc:… or did:web:…" aria-label="DID to add" testId="audience-did" autocomplete="off" autocapitalize="none" spellcheck=false flex=1 min-width=0 min-height=minTouchTarget() padding=spaceMd() border="1px solid bd.primary" border-radius=radiusMd() background-color="bg.field" color="tx.primary"
                  Button(controlId="", label="Add", kind="secondary", size="medium", icon=none, disabled=(audienceDid.trim() == ""), busy=pending(audienceGranted), press=addAudienceMember, testId="audience-add")
                if failed(audienceGranted)
                  text (match failure(audienceGranted) { case some(f) => f.message, case none => "Couldn’t add this DID." }) role="status" class=WhyteSm color="tx.secondary" testId="audience-error"
                if failed(audienceRevoked)
                  text "Couldn’t remove this DID. Try again." role="status" class=WhyteSm color="tx.secondary"
                if not audience.available and not pending(audience)
                  text "Couldn’t load your private audience." class=WhyteSm color="tx.secondary" role="status"
                if audience.principal == account.principal
                  for member in audience.members key=member.principal
                    row gap=spaceMd() align-items="center" flex-wrap="wrap" border-bottom="1px solid bd.primary" padding-bottom=spaceMd()
                      column flex=1 min-width=0 gap=spaceSm()
                        text member.principal class=WhyteSm overflow-wrap="anywhere" testId=`audience-member-${member.principal}`
                        text (member.access == "reply" ? "Can read and reply" : "Read only") class=WhyteXs color="tx.secondary"
                      Button(controlId="", label="Remove", kind="ghost", size="medium", icon=none, disabled=pending(audienceRevoked), busy=false, press=removeAudienceMember(member.principal), testId=`audience-remove-${member.principal}`)
                  if audience.members.length == 0 and audience.available and not pending(audience)
                    text "Only you can see your private posts." class=WhyteSm color="tx.secondary"
