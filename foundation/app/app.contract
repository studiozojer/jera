use JeraWordmark from "./brand.contract"

font "Whyte" = "assets/fonts/ABCWhyteEdu-Book.otf"
font "Whyte Inktrap" = "assets/fonts/ABCWhyteInktrap-Regular.otf"
font "Fraktion Mono" = "assets/fonts/PPFraktionMono-Regular.otf"

shape Clock
  epochAtZero: number
shape Account
  principal: string
shape AccountSuggestion
  did: string
  handle: string
  displayName: string
shape AccountSuggestions
  query: string
  items: AccountSuggestion[]
  available: bool
  complete: bool
shape Entry
  id: string
  name: string
shape Directory
  principal: string
  parent: string
  available: bool
  items: Entry[]
  complete: bool
shape Idea
  id: string
  body: string
  source: string
  status: string
shape Node
  id: string
  title: string
  body: string
  artifact: string
shape Board
  principal: string
  module: string
  ideas: Idea[]
  nodes: Node[]
  complete: bool
shape Ack
  state: string
  id: string
shape Draft
  principal: string
  module: string
  body: string
  source: string
  submitted: bool
  seq: number

component App
  state handle = ""
  state accountQuery = ""
  state selectedHandle = ""
  resource suggestions = lookupAccounts(accountQuery) as shape AccountSuggestions else empty()
  task searchAccounts when account.principal == "" and handle.trim() != accountQuery and handle != selectedHandle key=handle
    after(250, searchAccounts)
  action searchAccounts
    accountQuery = handle.trim()
  action chooseAccount(value: string)
    handle = value
    selectedHandle = value
    accountQuery = ""
  state armillary = ""
  state module = ""
  state armName = ""
  state moduleName = ""
  state sampledAt = 0
  resource time = exactTime() as shape Clock
  resource account = restore() with time.epochAtZero as shape Account else empty()
  resource arms = armillaries(account.principal) with time.epochAtZero + sampledAt as shape Directory else empty()
  resource modules = modules(account.principal, armillary) with time.epochAtZero + sampledAt as shape Directory else empty()
  resource board = board(account.principal, module) with time.epochAtZero + sampledAt as shape Board else empty()
  resource draft = loadDraft(account.principal, module) as shape Draft else empty()
  mutation saved as shape Ack queue refreshes draft
  mutation captured as shape Ack refreshes draft, board
  action save(p: string, m: string, body: string, source: string)
    send saved = saveDraft(p, m, body, source)
  action captureIdea(p: string, m: string, body: string, source: string)
    send captured = capture(p, m, body, source, time.epochAtZero + performanceNow())
  mutation signed as shape Ack refreshes account, arms, modules, board, draft then afterAuth
  mutation createdArm as shape Ack refreshes arms then afterArm
  mutation createdModule as shape Ack refreshes modules then afterModule
  task live mount
    every(5000, tick)
  action tick
    sampledAt = performanceNow()
    refresh draft
  action refreshAll
    sampledAt = performanceNow()
    refresh account
    refresh arms
    refresh modules
    refresh board
    refresh draft
  action afterAuth
    armillary = ""
    module = ""
    accountQuery = ""
    selectedHandle = handle
  action editHandle(v: string)
    handle = v
    selectedHandle = ""
    accountQuery = ""
  action editArmName(v: string)
    armName = v
  action editModuleName(v: string)
    moduleName = v
  action login
    send signed = login(handle, time.epochAtZero + performanceNow())
  action logout
    send signed = logout(time.epochAtZero + performanceNow())
  action chooseArm(id: string)
    armillary = id
    module = ""
  action chooseModule(id: string)
    module = id
  action makeArm
    send createdArm = createArmillary(armName.trim(), time.epochAtZero + performanceNow())
  action afterArm
    if match createdArm { case some(r) => r.state == "sent", case none => false }
      armillary = match createdArm { case some(r) => r.id, case none => "" }
      armName = ""
      module = ""
  action makeModule
    send createdModule = createModule(armillary, moduleName.trim(), time.epochAtZero + performanceNow())
  action afterModule
    if match createdModule { case some(r) => r.state == "sent", case none => false }
      module = match createdModule { case some(r) => r.id, case none => "" }
      moduleName = ""
  view
    column width="100%" height="100%" font-family="Whyte"
      header appearance="none" padding=16 display="flex" align-items="center" gap=8 flex-wrap="wrap"
        if account.principal == ""
          box role="heading" aria-level=1 flex="1 1 8rem"
            JeraWordmark()
        else
          text "Jera" role="heading" aria-level=1 flex="1 1 8rem" font-family="Whyte Inktrap" font-weight=400
        button "Refresh" press=refreshAll testId="refresh"
        if account.principal != "" and not pending(account) and not failed(account)
          button "Sign out" press=logout disabled=pending(signed) testId="logout"
      scroll flex=1 min-height=0
        column padding=12 gap=16 max-width="56.25rem" margin="0 auto" width="100%" box-sizing="border-box"
          if failed(account)
            text "Could not restore your session. Try refreshing." color="-exact-system-red"
          if failed(signed)
            text (match failure(signed) { case some(f) => f.message, case none => "" }) testId="auth-error" color="-exact-system-red"
          if account.principal == "" and not pending(account)
            column gap=12 max-width="26.25rem"
              text "Join the cycle." font="-exact-title2" role="heading" aria-level=2 font-family="Whyte Inktrap" font-weight=400
              text "Log in with your everything account, and bring your tokens into the network" color="-exact-secondary-label"
              input value=handle input=editHandle aria-label="ATproto handle or DID" placeholder="Name, handle or DID" testId="handle" font-family="Fraktion Mono" autocomplete="username" autocapitalize="none" spellcheck=false
              if handle != selectedHandle and handle.trim().length >= 2 and not handle.trim().startsWith("did:")
                if pending(suggestions) or accountQuery != handle.trim()
                  text "Looking for accounts…" font="-exact-footnote" color="-exact-secondary-label" aria-live="polite"
                if accountQuery == handle.trim() and suggestions.query == accountQuery and not pending(suggestions)
                  if failed(suggestions) or not suggestions.available
                    text "Suggestions unavailable. You can still enter your full handle or DID." font="-exact-footnote" color="-exact-secondary-label" testId="suggestions-error"
                  else
                    if suggestions.items.length > 0
                      column gap=8 role="group" aria-label="Account suggestions"
                        text "Suggested accounts" font="-exact-footnote" color="-exact-secondary-label"
                        for person, i in suggestions.items key=person.did
                          button press=chooseAccount(person.handle) appearance="none" testId=`suggestion-${i}` aria-label=`Use @${person.handle}` padding=12 border-width=1 border-color="-exact-separator" border-radius=8 background-color="-exact-secondary-background" color="-exact-label"
                            column gap=4 align-items="flex-start"
                              if person.displayName != ""
                                text person.displayName font-family="Whyte"
                              text `@${person.handle}` font-family="Fraktion Mono" font="-exact-footnote"
                    else
                      text "No matching account found. You can still enter your full handle or DID." font="-exact-footnote" color="-exact-secondary-label" testId="suggestions-empty"
                    if not suggestions.complete
                      text "More accounts may be available. Enter a full handle or DID if yours is missing." font="-exact-footnote" color="-exact-secondary-label"
              text "Sign in with your ATproto account. Your ideas stay private in Jera." color="-exact-secondary-label"
              row gap=12 flex-wrap="wrap"
                button "Continue with ATproto" press=login disabled=(pending(signed) or handle.trim() == "") testId="login" buttonStyle="filled"
          if account.principal != "" and not pending(account) and not failed(account)
            text account.principal font="-exact-footnote" testId="account-did" overflow-wrap="anywhere" font-family="Fraktion Mono"
            text "Your armillaries" font="-exact-title2" role="heading" aria-level=2 font-family="Whyte Inktrap" font-weight=400
            text "Each armillary holds its own modules and working context." color="-exact-secondary-label"
            if failed(arms) or (arms.principal == account.principal and not arms.available)
              text "Armillaries unavailable. Your saved ideas have not been cleared." testId="directory-error"
            if arms.principal == account.principal and arms.available and not failed(arms)
              for item, i in arms.items key=item.id
                button item.name press=chooseArm(item.id) testId=`arm-${i}` buttonStyle=(armillary == item.id ? "filled" : "bordered")
              if not arms.complete
                text "Partial directory. More records are available through the agent API." font="-exact-footnote"
            row gap=8 flex-wrap="wrap"
              input value=armName input=editArmName aria-label="Armillary name" placeholder="New armillary" testId="arm-name" flex="1 1 200px" min-width=0 font-family="Whyte"
              button "Create armillary" press=makeArm disabled=(armName.trim() == "" or pending(createdArm)) testId="create-arm"
            if failed(createdArm)
              text (match failure(createdArm) { case some(f) => f.message, case none => "" }) color="-exact-system-red"
            if match createdArm { case some(r) => r.state == "pending", case none => false }
              text "Armillary creation is queued. Refresh and select it when it appears."
            if armillary != ""
              text "Modules" role="heading" aria-level=2 font-family="Whyte Inktrap" font-weight=400
              if modules.principal == account.principal and modules.parent == armillary and modules.available and not failed(modules)
                for item, i in modules.items key=item.id
                  button item.name press=chooseModule(item.id) testId=`module-${i}` buttonStyle=(module == item.id ? "filled" : "bordered")
              if failed(modules) or (modules.parent == armillary and not modules.available)
                text "Modules unavailable. Refresh to reconnect."
              if modules.parent == armillary and modules.available and not modules.complete
                text "Partial module directory. More records are available through the agent API." font="-exact-footnote"
              row gap=8 flex-wrap="wrap"
                input value=moduleName input=editModuleName aria-label="Module name" placeholder="New module" testId="module-name" flex="1 1 200px" min-width=0 font-family="Whyte"
                button "Create module" press=makeModule disabled=(moduleName.trim() == "" or pending(createdModule)) testId="create-module"
              if failed(createdModule)
                text (match failure(createdModule) { case some(f) => f.message, case none => "" }) color="-exact-system-red"
              if match createdModule { case some(r) => r.state == "pending", case none => false }
                text "Module creation is queued. Refresh and select it when it appears."
            if module != ""
              if draft.principal == account.principal and draft.module == module and not failed(draft)
                for d in [draft] key=`${d.principal}-${d.module}-${d.seq}-${d.submitted}`
                  Composer(draft=d, save=save, submit=captureIdea, saving=pending(saved), sending=pending(captured), saveError=(match failure(saved) { case some(f) => f.message, case none => "" }), captureError=(match failure(captured) { case some(f) => f.message, case none => "" }))
              if failed(draft)
                text "Your draft could not be read. It has not been replaced." color="-exact-system-red"
              if failed(board)
                text "This module is unavailable. Refresh to reconnect or check your access." testId="board-error" color="-exact-system-red"
              if board.principal == account.principal and board.module == module and not failed(board)
                if not board.complete
                  text "Partial view. More records are available through the agent API." font="-exact-footnote"
                text "Ideas" role="heading" aria-level=2 font-family="Whyte Inktrap" font-weight=400
                if board.ideas.length == 0
                  text "Leave a fragment, a question, or an unfinished thought." color="-exact-secondary-label" testId="empty-ideas"
                for idea, i in board.ideas key=idea.id
                  column gap=8 padding=16 background-color="-exact-secondary-background" border-radius=12
                    text idea.body testId=`idea-${i}` white-space="pre-wrap"
                    if idea.source != ""
                      scroll overflow-x="scroll" overflow-y="hidden" height="2rem" width="100%" min-width=0
                        text idea.source testId=`source-${i}` font="-exact-footnote" white-space="nowrap" font-family="Fraktion Mono"
                    text idea.status font="-exact-footnote" color="-exact-secondary-label" testId=`work-${i}` font-family="Fraktion Mono"
                text "Organized context" role="heading" aria-level=2 font-family="Whyte Inktrap" font-weight=400
                if board.nodes.length == 0
                  text "An operator’s synthesis will appear here, linked to its original idea." color="-exact-secondary-label"
                for node, i in board.nodes key=node.id
                  column gap=8 padding=16 background-color="-exact-secondary-background" border-radius=12
                    text node.title role="heading" aria-level=3 testId=`node-title-${i}` font-family="Whyte Inktrap" font-weight=400
                    text node.body testId=`node-body-${i}` white-space="pre-wrap"
                    scroll overflow-x="scroll" overflow-y="hidden" height="2rem" width="100%" min-width=0
                      text `Source: ${node.artifact}` testId=`node-origin-${i}` font="-exact-caption1" white-space="nowrap" font-family="Fraktion Mono"

component Composer
  props
    draft: Draft
    save: action
    submit: action
    saving: bool
    sending: bool
    saveError: string
    captureError: string
  state body = draft.body
  state source = draft.source
  action edit(v: string)
    body = v
    save(draft.principal, draft.module, v, source)
  action editSource(v: string)
    source = v
    save(draft.principal, draft.module, body, v)
  action capture
    submit(draft.principal, draft.module, body, source)
  view
    column gap=12
      text "Capture an idea" role="heading" aria-level=2 font-family="Whyte Inktrap" font-weight=400
      textarea value=body input=edit disabled=(draft.submitted or sending) maxlength=12000 min-height=140 aria-label="Idea" placeholder="What’s on your mind?" testId="idea-input" font-family="Whyte"
      input value=source input=editSource disabled=(draft.submitted or sending) maxlength=2000 aria-label="Source link" placeholder="Source link (optional)" testId="source-input" font-family="Fraktion Mono"
      button (draft.submitted ? "Check delivery" : "Capture idea") press=capture disabled=(body.trim() == "" or saving or sending) buttonStyle="filled" testId="capture"
      if saving
        text "Saving draft…" font="-exact-footnote" font-family="Fraktion Mono"
      if saveError != ""
        text "Draft could not be saved. Keep this window open and try editing again." color="-exact-system-red" testId="draft-error"
      if draft.submitted
        text "Queued on this device. Check delivery before editing this idea." testId="queued" font="-exact-footnote" font-family="Fraktion Mono"
      if captureError != ""
        text captureError testId="capture-error" color="-exact-system-red"
