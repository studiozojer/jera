fresh
epoch now

test "capture survives reload and account boundaries"
  type "email" "owner@example.com"
  type "password" "correct horse battery staple"
  tap "signup"
  clock data
  type "arm-name" "Shared armillary"
  tap "create-arm"
  clock data
  type "module-name" "Jera"
  tap "create-module"
  clock data
  type "idea-input" "ᛃ A fragment about connected ideas ♊"
  type "source-input" "https://example.com/original"
  clock data
  reload
  clock data
  tap "arm-0"
  clock data
  tap "module-0"
  clock data
  tap "capture"
  clock data
  expect text "idea-0" == "ᛃ A fragment about connected ideas ♊"
  expect text "work-0" == "pending"
  expect tree missing "idea-1"
  tap "logout"
  clock data
  expect tree missing "idea-0"
  type "email" "other@example.com"
  type "password" "another correct horse password"
  tap "signup"
  clock data
  expect tree missing "arm-0"
  expect tree missing "idea-0"

test "queued capture is delivered once after a connection loss"
  type "email" "offline@example.com"
  type "password" "correct horse battery staple"
  tap "signup"
  clock data
  type "arm-name" "Offline armillary"
  tap "create-arm"
  clock data
  type "module-name" "Ideas"
  tap "create-module"
  clock data
  type "idea-input" "Keep this idea exactly once"
  clock data
  fail fetch "backend"
  tap "capture"
  clock data
  expect tree has "queued"
  reload
  clock data
  expect tree has "directory-error"
  pass fetch "backend"
  tap "refresh"
  clock data
  tap "arm-0"
  clock data
  tap "module-0"
  clock data
  tap "capture"
  clock data
  expect text "idea-0" == "Keep this idea exactly once"
  expect tree missing "idea-1"
  expect tree missing "queued"
