fresh
epoch now

// OAuth is a fixture here; authorization acceptance requires a real PDS.
test "sign-in reaches a quiet wordmark screen and survives reload"
  expect disabled "login"
  type "handle" "owner..test"
  clock data
  expect disabled "login"
  type "handle" "own"
  clock +300
  clock data
  expect disabled "login"
  expect tree has "suggestion-0"
  type "handle" key "Escape"
  clock settle
  expect state accountsOpen == false
  type "handle" "owne"
  clock +300
  clock data
  type "handle" key "ArrowDown"
  type "suggestion-0" key "Enter"
  expect text "handle" == "owner.test"
  clock data
  expect enabled "login"
  expect tree missing "account-did"
  expect tree missing "suggestion-0"
  tap "login"
  authorize
  clock data
  expect state account.principal == "did:plc:aaaaaaaaaaaaaaaaaaaaaaaa"
  expect tree has "jera-wordmark"
  expect tree missing "handle"
  expect tree missing "account-did"
  expect tree missing "refresh"
  expect tree missing "logout"
  expect tree missing "arm-name"
  expect tree missing "account-loading"
  clock +15000
  clock data
  expect state account.principal == "did:plc:aaaaaaaaaaaaaaaaaaaaaaaa"
  expect tree has "jera-wordmark"
  expect tree missing "account-loading"
  reload
  clock data
  expect state account.principal == "did:plc:aaaaaaaaaaaaaaaaaaaaaaaa"
  expect tree has "jera-wordmark"
  expect tree missing "handle"
  expect tree missing "refresh"

test "offline session restoration keeps the quiet signed-in screen"
  type "handle" "offline.test"
  tap "login"
  authorize
  clock data
  expect tree missing "handle"
  fail fetch "backend"
  reload
  clock data
  expect tree has "jera-wordmark"
  expect tree missing "handle"
  expect tree missing "account-loading"
  expect tree missing "retry-account"
  expect tree missing "refresh"
  expect tree missing "logout"
  clock +15000
  clock data
  expect tree missing "handle"
  expect tree missing "account-loading"
