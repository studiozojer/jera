# Explicit service hostname takes precedence over Jera's PDS handle wildcard.
# Public ACME certificate; no PDS account is needed for this infrastructure host.
snapback.jera.ink {
  # The PDS has an on-demand *.jera.ink policy. Issue this exact certificate.
  tls force_automate
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        -Server
    }
    reverse_proxy 127.0.0.1:4417 {
        flush_interval -1
    }
}
