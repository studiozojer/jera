test "a nested continuation opens without losing the original thread"
  tap "thread-seed-2"
  clock settle
  expect tree has "thread-body-seed-4"
  expect tree missing "thread-body-seed-59"
  tap "show-replies-seed-3"
  clock settle
  expect tree has "thread-body-seed-59"
  expect tree has "parent-thread"
  // Previous routes remain mounted for Back; visible-route isolation is browser-reviewed.
  tap "back"
  clock settle
  expect tree has "thread-body-seed-60"
  expect tree missing "thread-body-seed-59"
  tap "back"
  clock settle
  expect tree has "thread-seed-2"

test "replying to a nested post targets that post and returns through its branch"
  tap "thread-seed-2"
  clock settle
  tap "reply-to-seed-4"
  clock settle
  expect text "reply-recipient" == "Replying to David"
  expect text "reply-context" == "Yes. And pruning can be a kind of care."
  type "composer" "Keep this beside the pruning note."
  tap "post"
  clock settle
  expect text "thread-body-post-61" == "Keep this beside the pruning note."
  tap "back"
  clock settle
  expect tree missing "composer"
  expect tree has "show-replies-seed-3"
  tap "show-replies-seed-3"
  clock settle
  expect tree has "thread-body-post-61"

test "drafts belong to the individual reply recipient"
  tap "thread-seed-2"
  clock settle
  tap "reply-to-seed-3"
  clock settle
  type "composer" "A draft for Kepler."
  tap "cancel"
  clock settle
  tap "reply-to-seed-4"
  clock settle
  expect text "composer" == ""
  type "composer" "A draft for David."
  tap "cancel"
  clock settle
  tap "reply-to-seed-3"
  clock settle
  expect text "composer" == "A draft for Kepler."

test "a sibling added to a preview is reachable through all replies"
  tap "thread-seed-2"
  clock settle
  tap "reply-to-seed-3"
  clock settle
  type "composer" "A second branch beside David's reply."
  tap "post"
  clock settle
  expect text "thread-body-post-61" == "A second branch beside David's reply."
  tap "back"
  clock settle
  expect text "show-replies-seed-3" == "Show all 2 replies"
  tap "show-replies-seed-3"
  clock settle
  expect text "thread-body-post-61" == "A second branch beside David's reply."
