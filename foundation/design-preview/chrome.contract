use spaceSm, spaceMd, spaceLg, spaceXl, spaceXxl, spaceXxxl, radiusMd, radiusXl, radiusFull, iconSize from "./dao.contract"
use JeraWordmark from "./brand.contract"
use WhyteXs, QuietAction from "./dao.contract"

component Chrome
  props
    account: action
    compact: bool
  view
    box role="banner" padding-top=`calc(${compact ? spaceMd() : spaceXl()}px + env(safe-area-inset-top))` padding-bottom=(compact ? spaceMd() : spaceXl()) padding-left=(compact ? spaceLg() : spaceXxl()) padding-right=(compact ? spaceLg() : spaceXxl()) border-bottom-width=(compact ? 1 : 0) border-bottom-style="solid" border-bottom-color="bd.primary" width="100%" max-width="44rem" margin="0 auto" box-sizing="border-box" display="flex" align-items="center" justify-content="space-between" gap=spaceLg() flex-wrap="wrap"
      row gap=spaceMd() align-items="center" flex-wrap="wrap"
        JeraWordmark(scale=(compact ? 1.6 : 2))
        text "Preview" color="tx.secondary" class=WhyteXs
      row gap=spaceMd() align-items="center" flex-wrap="wrap"
        button press=account aria-label="Your account" testId="account" appearance="none" class=QuietAction width="2.75rem" height="2.75rem" padding=0 border-width=0 border-radius=radiusMd() background-color="bg.field" color="tx.primary"
          text "D"

component WriteButton
  props
    write: action
    compact: bool
  view
    button press=write aria-label="Write a post" testId="write" appearance="none" class=QuietAction position="absolute" right=(compact ? spaceLg() : spaceXxl()) bottom=`calc(${compact ? spaceLg() : spaceXxl()}px + env(safe-area-inset-bottom))` z-index=10 width=(compact ? spaceXxxl() + spaceLg() : spaceXxxl() * 2) height=(compact ? spaceXxxl() + spaceLg() : spaceXxxl() * 2) padding=0 display="flex" align-items="center" justify-content="center" border="1px solid bd.primary" border-radius=radiusXl() background-color="bg.base" color="tx.primary"
      image "symbol:add" font-size=iconSize() aria-hidden=true

// The page scrolls behind this sticky header. The cap only paints the
// stationary outline/corners; it never owns scrolling or pointer input.
component ReadingHeader
  props
    account: action
    compact: bool
    measure: action
  view
    column resize=measure position="sticky" top=0 z-index=2 background-color="bg.base" padding-bottom=(compact ? 0 : spaceSm()) testId="reading-header"
      Chrome(account=account, compact=compact)
      if not compact
        box position="absolute" top="100%" width="100%" height=radiusFull() pointer-events="none" aria-hidden=true testId="reading-cap"
          box width="100%" max-width="44rem" margin="0 auto" height=radiusFull() padding-left=spaceMd() padding-right=spaceMd() box-sizing="border-box"
            box position="relative" width="100%" height=radiusFull()
              box position="absolute" left=radiusFull() right=radiusFull() top=0 height=1 background-color="bd.primary"
              svg position="absolute" left=0 top=0 width=radiusFull() height=radiusFull() viewBox="0 0 32 32"
                path d="M0 0H32A32 32 0 0 0 0 32Z" fill="bg.base"
                path d="M0.5 32A31.5 31.5 0 0 1 32 0.5" fill="none" stroke="bd.primary" stroke-width=1
              svg position="absolute" right=0 top=0 width=radiusFull() height=radiusFull() viewBox="0 0 32 32"
                path d="M0 0H32V32A32 32 0 0 0 0 0Z" fill="bg.base"
                path d="M0 0.5A31.5 31.5 0 0 1 31.5 32" fill="none" stroke="bd.primary" stroke-width=1
