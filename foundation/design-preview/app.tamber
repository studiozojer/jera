// daoUI:theme:end
  bg.base = light-dark(#FAF9F6, #1A1714)
  // Bridge daoUI into the host-owned surface, including sheet safe areas.
  background = bg.base
  Canvas = bg.base
  bg.field = light-dark(#3D403B14, #F3F6F814)
  bg.card = light-dark(#F7F3EC, #2C2721)
  bg.hover = light-dark(#EFE9DF, #342F2A)
  bg.pressed = light-dark(#E7DFD3, #3C3832)
  // David's sign-in accent, with opaque readable ink and derived interaction states.
  bg.action = #F7B667 scheme=fixed
  bg.action-hover = #F9C486 scheme=fixed
  bg.action-pressed = #DDA35D scheme=fixed
  tx.on-action = #1A1714 scheme=fixed
  tx.primary = light-dark(#191B18, #FEFFFFF2)
  tx.secondary = light-dark(#3D403BBF, #F3F6F8B3)
  tx.warning = light-dark(#F18736F2, #F18736F2)
  tx.link = #F7B667 scheme=fixed
  ic.disabled = light-dark(#3D403B26, #F3F6F826)
  bd.primary = light-dark(#3D403B26, #F3F6F826)

// Local outline expressions for the post toolbar; use SF Symbols on Apple.
icons
  icon.post-comment = icon(sf "bubble.left", svg "icons/post-comment.svg")
  icon.post-send = icon(sf "paperplane", svg "icons/post-send.svg")

