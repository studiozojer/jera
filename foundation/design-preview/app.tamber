// Consumer expression: retain David's gold action and opaque hover surfaces.
params
  Button.primaryFill = bg.action
  Button.primaryHover = bg.action-hover
  Button.primaryPressed = bg.action-pressed
  Button.primaryDisabled = bg.field
  Button.primaryInk = tx.on-action
  IconButton.surfaceFill = bg.base
  IconButton.ink = tx.secondary
  IconButton.hoverFill = bg.hover
  IconButton.pressedFill = bg.pressed
