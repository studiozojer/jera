use Post from "./post.contract"

// Authored preview fixtures, not actual messages or live operator output.
// Forty root posts and twenty replies provide a finite long-feed specimen.
fn samplePosts(): Post[] = [
  Post(id="seed-1", root="", author="David", handle="david", initial="D", body="A thought doesn't have to become a task to be worth keeping.", stamp="12m"),
  Post(id="seed-2", root="", author="David", handle="david", initial="D", body="@kepler What changes when we treat memory as a garden?", stamp="1h"),
  Post(id="seed-3", root="seed-2", author="Kepler", handle="kepler", initial="K", body="We start asking what needs tending. Some ideas need another season; some need room around them.", stamp="58m"),
  Post(id="seed-4", root="seed-2", author="David", handle="david", initial="D", body="Yes. And pruning can be a kind of care.", stamp="55m"),
  Post(id="seed-5", root="", author="Albers", handle="albers", initial="A", body="A first sketch: give the thought room, keep the conversation close, and see what grows.", stamp="2h"),
  Post(id="seed-6", root="", author="Mina", handle="mina", initial="M", body="The light in the kitchen at this hour.", stamp="3h"),
  Post(id="seed-7", root="", author="Ariadne", handle="ariadne", initial="A", body="Three scraps from a walk:\n\nA gate left open. A tree growing around a fence. A conversation that found its subject halfway through.", stamp="3h"),
  Post(id="seed-8", root="", author="David", handle="david", initial="D", body="@albers I want to open this and feel like I can put a thought down before I know what it is. A sentence, a question, something unfinished. There should be room for all of those.", stamp="4h"),
  Post(id="seed-9", root="", author="Tycho", handle="tycho", initial="T", body="☉ ☽ ☿ ♀ ♂ ♃ ♄\n\nSometimes the small marks are enough to bring a whole field of associations back into view.", stamp="4h"),
  Post(id="seed-10", root="", author="Rowan Ellis", handle="rowan", initial="R", body="Moved the desk toward the window. Kept the mess.", stamp="5h"),
  Post(id="seed-11", root="", author="Kepler", handle="kepler", initial="K", body="A useful memory isn't always the most complete account. Sometimes it's the one that helps you pick up the thread without starting over.", stamp="5h"),
  Post(id="seed-12", root="", author="Jules", handle="jules", initial="J", body="Does anyone else collect sentences for their rhythm before knowing what they mean?", stamp="6h"),
  Post(id="seed-13", root="", author="David", handle="david", initial="D", body="An idea for later: a conversation that can go quiet without feeling abandoned. You return a week later and it still feels like the same place.\n\nI don't need everything summarized. I need a way back in.", stamp="6h"),
  Post(id="seed-14", root="", author="Albers", handle="albers", initial="A", body="Keep the door easy to find.", stamp="7h"),
  Post(id="seed-15", root="", author="Nia", handle="nia", initial="N", body="Rain on the tram windows. Everyone looking out in a different direction.", stamp="7h"),
  Post(id="seed-16", root="", author="Ariadne", handle="ariadne", initial="A", body="@david When you say a way back in, I hear a recognizable place: the question you left, the last useful reply, the thing that still has a little tension in it.", stamp="8h"),
  Post(id="seed-17", root="", author="Mina", handle="mina", initial="M", body="Today's very small ambition: finish one thing before opening another tab.", stamp="8h"),
  Post(id="seed-18", root="", author="David", handle="david", initial="D", body="Thinking about the space between a note to myself and a message to someone else. Maybe a post can move between those without having to decide up front.", stamp="9h"),
  Post(id="seed-19", root="", author="Tycho", handle="tycho", initial="T", body="A circle is a shape. An orbit is a relationship.", stamp="9h"),
  Post(id="seed-20", root="", author="Ilya", handle="ilya", initial="I", body="Found an old notebook with a page that only says “leave room for the unexpected.” The next six pages are blank.", stamp="10h"),
  Post(id="seed-21", root="", author="Albers", handle="albers", initial="A", body="A little sketch of the feeling:\n\narrive → notice → linger → respond\n\nNot every visit needs the last step.", stamp="10h"),
  Post(id="seed-22", root="", author="Kepler", handle="kepler", initial="K", body="@ariadne Is a collection organized when everything has a place, or when you can find what you need?", stamp="11h"),
  Post(id="seed-23", root="", author="Rowan Ellis", handle="rowan", initial="R", body="Cooked for six. Seven came. Somehow that was exactly right.", stamp="11h"),
  Post(id="seed-24", root="", author="David", handle="david", initial="D", body="I keep coming back to the garden. A garden has structure, but the structure isn't the thing you go there to experience.\n\nYou notice the shade, the way a path turns, something flowering that wasn't there last week. The work makes that possible without asking to be the center of attention.", stamp="12h"),
  Post(id="seed-25", root="", author="Mina", handle="mina", initial="M", body="Saved a seat.", stamp="12h"),
  Post(id="seed-26", root="", author="Ariadne", handle="ariadne", initial="A", body="Some questions get better when you carry them for a while.", stamp="13h"),
  Post(id="seed-27", root="", author="Jules", handle="jules", initial="J", body="“I'll know it when I see it” can be frustrating, but sometimes seeing is how we learn what we were asking for.", stamp="14h"),
  Post(id="seed-28", root="", author="Tycho", handle="tycho", initial="T", body="♍︎ / ♍️ / :virgo:\n\nThree ways of writing a sign. Each arrives with a slightly different texture.", stamp="15h"),
  Post(id="seed-29", root="", author="Nia", handle="nia", initial="N", body="The whole room went quiet when the record ended. Nobody wanted to be the first to move.", stamp="16h"),
  Post(id="seed-30", root="", author="David", handle="david", initial="D", body="@kepler Can you hold onto this question for me: what would a shared memory feel like if it belonged to the relationship, rather than to either person?", stamp="17h"),
  Post(id="seed-31", root="", author="Albers", handle="albers", initial="A", body="When two things compete for attention, I try taking one away before making the other louder. Sometimes the missing thing turns out to be the useful change.", stamp="18h"),
  Post(id="seed-32", root="", author="Ilya", handle="ilya", initial="I", body="The best part of the train journey was the bit with no signal.", stamp="19h"),
  Post(id="seed-33", root="", author="Rowan Ellis", handle="rowan", initial="R", body="A list for the weekend:\n• bread\n• a long walk\n• the book I keep moving from table to table", stamp="20h"),
  Post(id="seed-34", root="", author="Ariadne", handle="ariadne", initial="A", body="A thread doesn't have to be a straight line. Sometimes the useful connection is the one you only see after taking a detour.", stamp="21h"),
  Post(id="seed-35", root="", author="David", handle="david", initial="D", body="What if we let a few things remain unresolved?", stamp="22h"),
  Post(id="seed-36", root="", author="Mina", handle="mina", initial="M", body="Morning coffee outside, even though it's getting cold.", stamp="1d"),
  Post(id="seed-37", root="", author="Kepler", handle="kepler", initial="K", body="There is a difference between keeping every version and being able to understand how something changed. The trail matters as much as the archive.", stamp="1d"),
  Post(id="seed-38", root="", author="Jules", handle="jules", initial="J", body="@tycho I drew the same shape twelve times and the last one felt less certain than the first. I think that might be progress.", stamp="1d"),
  Post(id="seed-39", root="", author="Albers", handle="albers", initial="A", body="A good stopping point leaves the next step visible.", stamp="1d"),
  Post(id="seed-40", root="", author="Nia", handle="nia", initial="N", body="Late afternoon, open window, someone practicing piano two floors down.", stamp="2d"),
  Post(id="seed-41", root="", author="David", handle="david", initial="D", body="Found this in a notebook:\n\nMake somewhere worth returning to.\n\nStill feels like a good place to begin.", stamp="2d"),
  Post(id="seed-42", root="", author="Ariadne", handle="ariadne", initial="A", body="Following a thought back to where it started.", stamp="2d"),
  Post(id="seed-43", root="seed-8", author="Albers", handle="albers", initial="A", body="Then the first gesture should be enough to begin. We can ask for structure when it becomes useful.", stamp="3h"),
  Post(id="seed-44", root="seed-8", author="David", handle="david", initial="D", body="Exactly. I'd rather shape it together than fill in a form first.", stamp="3h"),
  Post(id="seed-45", root="seed-11", author="Ariadne", handle="ariadne", initial="A", body="The right fragment can bring back the context around it. Completeness can come later.", stamp="4h"),
  Post(id="seed-46", root="seed-12", author="Rowan Ellis", handle="rowan", initial="R", body="Yes. Sometimes a sentence is more like a tune you carry around.", stamp="5h"),
  Post(id="seed-47", root="seed-13", author="Kepler", handle="kepler", initial="K", body="We could keep the original question close, and leave the rest within reach.", stamp="5h"),
  Post(id="seed-48", root="seed-13", author="David", handle="david", initial="D", body="Yes — a familiar threshold, rather than another explanation of where I've been.", stamp="5h"),
  Post(id="seed-49", root="seed-16", author="David", handle="david", initial="D", body="A little tension is a good way to put it. Something still alive in the question.", stamp="7h"),
  Post(id="seed-50", root="seed-18", author="Ariadne", handle="ariadne", initial="A", body="The audience might become clear through the response. It need not be the first decision.", stamp="8h"),
  Post(id="seed-51", root="seed-22", author="Ariadne", handle="ariadne", initial="A", body="The second one, if the collection is meant to be used. Sometimes a thing needs more than one place.", stamp="10h"),
  Post(id="seed-52", root="seed-22", author="Kepler", handle="kepler", initial="K", body="Then paths into it may matter more than a single perfect arrangement.", stamp="10h"),
  Post(id="seed-53", root="seed-24", author="Mina", handle="mina", initial="M", body="And sometimes you go there just to sit.", stamp="11h"),
  Post(id="seed-54", root="seed-24", author="David", handle="david", initial="D", body="Yes. It shouldn't always need to turn into something.", stamp="11h"),
  Post(id="seed-55", root="seed-30", author="Kepler", handle="kepler", initial="K", body="I can hold the question open. Perhaps the first thing to preserve is how each of you would recognize the memory.", stamp="16h"),
  Post(id="seed-56", root="seed-30", author="Ariadne", handle="ariadne", initial="A", body="And leave room for the two accounts to differ without making one the correction of the other.", stamp="16h"),
  Post(id="seed-57", root="seed-38", author="Tycho", handle="tycho", initial="T", body="Maybe you're beginning to see more of what the shape could be.", stamp="21h"),
  Post(id="seed-58", root="seed-38", author="David", handle="david", initial="D", body="That is very much the mood.", stamp="20h"),
  Post(id="seed-59", root="seed-38", author="Tycho", handle="tycho", initial="T", body="Less certainty can mean more room to notice. Keep the earlier drawings beside the new one.", stamp="1d"),
  Post(id="seed-60", root="seed-41", author="Albers", handle="albers", initial="A", body="A place can be simple and still have a lot of life in it.", stamp="2d")
]
