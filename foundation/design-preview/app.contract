use spaceSm, spaceMd, spaceLg, spaceXl, spaceXxl, spaceXxxl, radiusSm, radiusMd, radiusFull, minTouchTarget from "./dao.contract"
use Post, Author, PostAvatar, PostActions, Draft from "./post.contract"
use samplePosts from "./fixtures.contract"
use WhyteSm, WhyteXs, WhyteMd, WhyteLg, QuietAction, PrimaryAction from "./dao.contract"
use ReadingHeader, WriteButton from "./chrome.contract"

shape Viewport
  width: number

font "Whyte" = "assets/fonts/ABCWhyteEdu-Book.otf"
font "Whyte Inktrap" = "assets/fonts/ABCWhyteInktrap-Regular.otf"

routes nav
  home "/"
    thread "/thread/:id"
    compose "/write"
    account "/account"

component App
  resource viewport = exactViewport() as shape Viewport
  derive compact = viewport.width < 704
  state headerHeight = 0
  state posts = samplePosts()
  state drafts = [Draft(context="", body="")]
  state replyTo = ""
  derive draft = match first(drafts.filter(d => d.context == replyTo)) { case some(d) => d.body, case none => "" }
  task defaultTheme mount
    after(1, darkTheme)
  action darkTheme
    setScheme("dark")
  action follow(url: string)
    nav = go(nav, url)
  action dismiss
    nav = back(nav)
  action write
    replyTo = ""
    nav = push(nav, "/write")
  action reply(id: string)
    replyTo = id
    nav = push(nav, "/write")
  action edit(value: string)
    drafts = drafts.filter(d => d.context != replyTo).concat([Draft(context=replyTo, body=value)])
  action post
    if draft.trim() != ""
      let id = `post-${posts.length + 1}`
      posts = posts.concat([Post(id=id, root=replyTo, author="David", handle="david", initial="D", body=draft, stamp="now")])
      drafts = drafts.filter(d => d.context != replyTo)
      // Posting consumes the temporary composer. A reply returns to its
      // existing thread; a new post opens above the screen that invoked it.
      nav = replyTo == "" ? push(back(nav), path("thread", id)) : back(nav)
  action measureHeader(w: number, h: number)
    if h > 0
      headerHeight = h + (compact ? 0 : spaceSm())
  action account
    nav = push(nav, "/account")
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" color-scheme="dark" font-family="Whyte" background-color="bg.base" color="tx.primary" interactive-widget="resizes-content" display="flex" flex-direction="column"
      for entry in stack(nav) key=entry.id
        if entry.name == "home"
          column navigationKey=`${entry.id}` navigationBar="none" position="absolute" inset=0 box-sizing="border-box"
            scroll id="stream" testId="stream" aria-label="Posts" tabindex=0 flex=1 min-height=0 width="100%" overflow-y="auto" overflow-x="hidden"
              column min-height="100%"
                ReadingHeader(account=account, compact=compact, measure=measureHeader)
                column flex=1 min-height=0 width="100%" max-width="44rem" margin="0 auto" box-sizing="border-box" padding-right=(compact ? 0 : spaceMd()) padding-left=(compact ? 0 : spaceMd())
                  column flex=1 border-left-width=(compact ? 0 : 1) border-right-width=(compact ? 0 : 1) border-left-style="solid" border-right-style="solid" border-color="bd.primary" padding-bottom=(compact ? "5rem" : "6rem")
                    for item, index in posts.filter(p => p.root == "") key=item.id
                      article padding-top=(compact ? spaceMd() : spaceLg()) padding-bottom=(compact ? spaceMd() : spaceLg()) padding-left=spaceLg() padding-right=spaceLg() border-top-width=(index == 0 ? 0 : 1) border-top-style="solid" border-top-color="bd.primary" display="flex" flex-direction="column" gap=spaceSm()
                        row gap=spaceMd() align-items="flex-start" flex-wrap="wrap"
                          PostAvatar(post=item)
                          column flex=1 flex-basis="12rem" min-width=0 gap=spaceSm()
                            Author(post=item, menuId=`stream-menu-${item.id}`, clearance=(headerHeight + spaceSm()))
                            text item.body class=WhyteSm white-space="pre-wrap" testId=`body-${item.id}`
                            PostActions(post=item, comments=posts.filter(p => p.root == item.id).length, comment=follow(path("thread", item.id)), commentId=`thread-${item.id}`, commentLabel="Open conversation", context=`stream-${item.id}`, clearance=(headerHeight + spaceSm()))
                    text "Sample conversations" color="tx.secondary" class=WhyteXs padding-top=spaceXxl() padding-left=spaceLg()
                    box height="env(safe-area-inset-bottom)" flex-shrink=0
            WriteButton(write=write, compact=compact)
        if entry.name == "thread"
          column navigationKey=`${entry.id}` navigationBar="none" position="absolute" inset=0 box-sizing="border-box"
            scroll id="conversation" testId="conversation" aria-label="Conversation" tabindex=0 flex=1 min-height=0 width="100%" overflow-y="auto" overflow-x="hidden"
              column min-height="100%"
                ReadingHeader(account=account, compact=compact, measure=measureHeader)
                column flex=1 min-height=0 width="100%" max-width="44rem" margin="0 auto" box-sizing="border-box" padding-right=(compact ? 0 : spaceMd()) padding-left=(compact ? 0 : spaceMd())
                  column flex=1 border-left-width=(compact ? 0 : 1) border-right-width=(compact ? 0 : 1) border-left-style="solid" border-right-style="solid" border-color="bd.primary" padding-bottom=(compact ? "5rem" : "6rem")
                    row align-items="center" gap=spaceMd() padding=(compact ? spaceLg() : spaceXxl())
                      button "←" id="back" press=dismiss aria-label="Back" testId="back" scroll-margin-top=(headerHeight + spaceSm()) appearance="none" class=QuietAction width="2.75rem" min-height=minTouchTarget() padding=0 border-width=0 border-radius=radiusMd() background-color="transparent"
                      text "Thread" role="heading" aria-level=1 font-family="Whyte Inktrap" font-weight=400 class=WhyteMd
                    for item in posts.filter(p => p.id == entry.params.id or p.root == entry.params.id) key=item.id
                      article padding-top=(compact ? spaceMd() : spaceLg()) padding-bottom=(compact ? spaceMd() : spaceLg()) padding-left=spaceLg() padding-right=spaceLg() border-top="1px solid bd.primary" display="flex" flex-direction="column" gap=spaceSm()
                        row gap=spaceMd() align-items="flex-start" flex-wrap="wrap"
                          PostAvatar(post=item)
                          column flex=1 flex-basis="12rem" min-width=0 gap=spaceSm()
                            Author(post=item, menuId=`thread-menu-${entry.id}-${item.id}`, clearance=(headerHeight + spaceSm()))
                            text item.body class=(item.id == entry.params.id ? WhyteMd : WhyteSm) white-space="pre-wrap" testId=`thread-body-${item.id}`
                            PostActions(post=item, comments=posts.filter(p => p.root == item.id).length, comment=reply(entry.params.id), commentId=(item.id == entry.params.id ? "reply" : `reply-${entry.id}-${item.id}`), commentLabel="Write a reply", context=`thread-${entry.id}-${item.id}`, clearance=(headerHeight + spaceSm()))
                    box height="env(safe-area-inset-bottom)" flex-shrink=0
            WriteButton(write=write, compact=compact)
        if entry.name == "compose"
          column navigationKey=`${entry.id}` navigationBar="none" navigationPresentation="modal" navigationDetent="fit-content" navigationGrabber="visible" position="absolute" inset=0 background-color="bg.base" color="tx.primary" font-family="Whyte" padding=spaceXxl() gap=spaceXxl() box-sizing="border-box" overflow-y="auto"
            row align-items="center" justify-content="space-between" gap=spaceLg() flex-wrap="wrap"
              button "Cancel" id="back" press=dismiss testId="cancel" appearance="none" class=QuietAction min-height=minTouchTarget() padding-top=spaceSm() padding-bottom=spaceSm() padding-left=spaceMd() padding-right=spaceMd() border-width=0 border-radius=radiusMd() background-color="transparent" font-family="Whyte"
              text (replyTo == "" ? "New post" : "Reply") role="heading" aria-level=1 font-family="Whyte Inktrap" font-weight=400 class=WhyteMd
              button "Post" press=post testId="post" disabled=(draft.trim() == "") cursor=(draft.trim() == "" ? "default" : "pointer") appearance="none" class=PrimaryAction font-family="Whyte" min-height=minTouchTarget() padding-top=spaceSm() padding-bottom=spaceSm() padding-left=spaceXl() padding-right=spaceXl() border-width=0 border-radius=radiusMd()
            textarea id="composer" value=draft input=edit placeholder=(replyTo == "" ? "What's on your mind?" : "Continue the conversation…") aria-label=(replyTo == "" ? "Write a post" : "Write a reply") testId="composer" outline="none" rows=8 min-height=224 width="100%" box-sizing="border-box" padding-top=spaceSm() padding-bottom=spaceSm() border-width=0 background-color="transparent" color="tx.primary" font-family="Whyte" class=WhyteSm resize="none"
        if entry.name == "account"
          column navigationKey=`${entry.id}` navigationBar="none" navigationPresentation="modal" navigationDetent="fit-content" navigationGrabber="visible" position="absolute" inset=0 padding=spaceXxl() gap=spaceLg() background-color="bg.base" color="tx.primary"
            text "David" role="heading" aria-level=1 font-family="Whyte Inktrap" font-weight=400 class=WhyteLg
            text "Sample account · design preview" color="tx.secondary"
            button "Done" id="back" press=dismiss testId="account-done" cursor="pointer" min-height=minTouchTarget()
