use spaceSm, spaceMd, spaceLg, spaceXl, spaceXxl, spaceXxxl, radiusSm, radiusMd, radiusFull, minTouchTarget from "./dao.contract"
use Post, Author, PostAvatar, PostActions, Draft, conversationRoot, canReplyInExperience from "./post.contract"
use samplePosts from "./fixtures.contract"
use WhyteSm, WhyteXs, WhyteMd, WhyteLg, QuietAction from "./dao.contract"
use ReadingHeader, ThreadHeader, WriteButton, FeedComposer from "./chrome.contract"
use ThreadHero, ThreadBranch, ThreadReplyEntry from "./thread.contract"
use Button, Action from "./dao/actions.contract"
use ExperienceSnapshot, ExperienceModeControl from "./experience.contract"

shape Viewport
  width: number

shape Clock
  epochAtZero: number

font "Whyte" = "assets/fonts/ABCWhyteEdu-Book.otf"
font "Whyte Inktrap" = "assets/fonts/ABCWhyteInktrap-Regular.otf"

routes nav
  home "/"
    thread "/thread/:id"
    compose "/write"
    account "/account"

component App
  resource time = exactTime() as shape Clock
  resource viewport = exactViewport() as shape Viewport
  derive compact = viewport.width < 704
  state feedHeaderHeight = 0
  state threadHeaderHeight = 0
  resource experienceState = experienceSnapshot() as shape ExperienceSnapshot else empty()
  mutation experienceChanged as shape ExperienceSnapshot refreshes experienceState then afterExperienceChange
  derive currentExperience = match experienceChanged { case some(s) => s.revision >= experienceState.revision ? s : experienceState, case none => experienceState }
  derive mode = currentExperience.mode == "private" ? "private" : "public"
  state posts = samplePosts()
  // Public records may supply readable context inside a private conversation.
  // This projection is synthetic UI policy, not backend access enforcement.
  derive visiblePosts = posts.filter(p => p.visibility == "public" or mode == "private")
  state createdOrder: string[] = []
  derive feedCandidates = posts.filter(p => p.visibility == mode and (p.parent == "" or (mode == "private" and posts.filter(parent => parent.id == p.parent and parent.visibility == "public").length > 0)))
  // Creation order is preview-local; live feeds will order by storage timestamps.
  derive feedPosts = sortBy(feedCandidates, p => createdOrder.indexOf(p.id) < 0 ? createdOrder.length : createdOrder.indexOf(p.id))
  state drafts: Draft[] = []
  state replyTo = ""
  state composeContextChanged = false
  state lastPosted = ""
  derive privateReply = posts.filter(p => p.id == replyTo and p.visibility == "private").length > 0
  // An unsent reply belongs to its recipient; the picker changes its audience.
  // New-post drafts remain distinct for each global experience.
  derive draftMode = replyTo == "" ? mode : "reply"
  derive draft = match first(drafts.filter(d => d.context == replyTo and d.mode == draftMode)) { case some(d) => d.body, case none => "" }
  task defaultTheme mount
    after(1, darkTheme)
  action darkTheme
    setScheme("dark")
  // One canvas-only presentation experiment. Future lexicon/context policies
  // resolve here rather than forking app routes or duplicating base components.
  task experienceTheme when currentExperience.mode != "" key=currentExperience.revision
    after(1, applyExperienceTheme)
  action applyExperienceTheme
    setMode("experience", mode)
  action selectExperience(value: string)
    if value != mode and not pending(experienceChanged) and (replyTo == "" or canReplyInExperience(posts, replyTo, value))
      send experienceChanged = changeExperience(value, time.epochAtZero + performanceNow())
  action afterExperienceChange
    // Retain recipient, editor and unsent reply text during an audience change.
    composeContextChanged = true
  action follow(url: string)
    nav = top(nav).name == "compose" and composeContextChanged and url != "/write" ? (replyTo == "" ? go(nav, "/") : push(go(nav, "/"), path("thread", replyTo))) : go(nav, url)
  action openThread(id: string)
    nav = push(nav, path("thread", id))
  action dismiss
    nav = top(nav).name == "compose" and composeContextChanged ? (replyTo == "" ? go(nav, "/") : push(go(nav, "/"), path("thread", replyTo))) : back(nav)
  action write
    composeContextChanged = false
    replyTo = ""
    nav = push(nav, "/write")
  action reply(id: string)
    composeContextChanged = false
    replyTo = id
    nav = push(nav, "/write")
  action edit(value: string)
    drafts = drafts.filter(d => d.context != replyTo or d.mode != draftMode).concat([Draft(mode=draftMode, context=replyTo, body=value)])
  action post
    if draft.trim() != "" and not pending(experienceChanged) and (replyTo == "" or canReplyInExperience(posts, replyTo, mode))
      let id = `post-${posts.length + 1}`
      let created = Post(id=id, root=(replyTo == "" ? "" : conversationRoot(visiblePosts, replyTo)), parent=replyTo, visibility=mode, author="David", handle="david", initial="D", body=draft, stamp="now")
      // The feed reads newest first; conversations retain oldest-first replies.
      posts = replyTo == "" ? [created].concat(posts) : posts.concat([created])
      createdOrder = [id].concat(createdOrder)
      drafts = drafts.filter(d => d.context != replyTo or d.mode != draftMode)
      // Consume the composer and focus the actual recipient's conversation.
      let previous = composeContextChanged ? go(nav, "/") : back(nav)
      nav = replyTo == "" ? push(previous, path("thread", id)) : (top(previous).params.id == replyTo ? previous : push(previous, path("thread", replyTo)))
      lastPosted = id
  task revealPosted when lastPosted != "" and top(nav).name == "thread" key=lastPosted
    after(1, revealPost)
  action revealPost
    scrollIntoView(`thread-${top(nav).id}-${lastPosted}`, block="nearest")
    lastPosted = ""
  action measureFeedHeader(w: number, h: number)
    if h > 0
      feedHeaderHeight = h + (compact ? 0 : spaceSm())
  action measureThreadHeader(w: number, h: number)
    if h > 0
      threadHeaderHeight = h + (compact ? 0 : spaceSm())
  action account
    nav = push(nav, "/account")
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" color-scheme="dark" font-family="Whyte" background-color="experience.canvas" color="tx.primary" interactive-widget="resizes-content" display="flex" flex-direction="column"
      for entry in stack(nav) key=entry.id
        if entry.name == "home"
          column navigationKey=`${entry.id}` navigationBar="none" position="absolute" inset=0 box-sizing="border-box"
            scroll id="stream" testId="stream" aria-label=(mode == "private" ? "Private posts" : "Public posts") tabindex=0 flex=1 min-height=0 width="100%" overflow-y="auto" overflow-x="hidden"
              column min-height="100%"
                ReadingHeader(account=account, compact=compact, measure=measureFeedHeader, mode=mode)
                column flex=1 min-height=0 width="100%" max-width="44rem" margin="0 auto" box-sizing="border-box" padding-right=(compact ? 0 : spaceMd()) padding-left=(compact ? 0 : spaceMd())
                  column flex=1 border-left-width=(compact ? 0 : 1) border-right-width=(compact ? 0 : 1) border-left-style="solid" border-right-style="solid" border-color="bd.primary" padding-bottom=(compact ? "5rem" : "6rem")
                    FeedComposer(write=write)
                    for item, index in feedPosts key=item.id
                      article press=openThread(item.id) role="link" aria-label=`Open thread by ${item.author}: ${item.body.slice(0, 64)}` tabindex=0 testId=`post-row-${item.id}` class=Action border-radius=0 scroll-margin-top=(feedHeaderHeight + spaceSm()) padding-top=spaceMd() padding-bottom=spaceMd() padding-left=spaceLg() padding-right=spaceLg() border-top-width=(index == 0 ? 0 : 1) border-top-style="solid" border-top-color="bd.primary" display="flex" flex-direction="column" gap=spaceSm()
                        :hover
                          background-color="transparent"
                        row gap=spaceMd() align-items="flex-start" flex-wrap="wrap"
                          PostAvatar(post=item)
                          column flex=1 flex-basis="12rem" min-width=0 gap="dao.space.xs"
                            Author(post=item, menuId=`stream-menu-${item.id}`, clearance=(feedHeaderHeight + spaceSm()))
                            if item.parent != ""
                              for parent in visiblePosts.filter(p => p.id == item.parent) key=parent.id
                                text `Private reply to ${parent.author}` class=WhyteXs color="tx.secondary"
                            text item.body class=WhyteSm white-space="pre-wrap" testId=`body-${item.id}`
                            PostActions(post=item, comments=visiblePosts.filter(p => p.parent == item.id).length, comment=openThread(item.id), commentId=`thread-${item.id}`, commentLabel="Open conversation", context=`stream-${item.id}`, clearance=(feedHeaderHeight + spaceSm()))
                    text (mode == "private" ? "Private sample conversations" : "Public sample conversations") color="tx.secondary" class=WhyteXs padding-top=spaceXxl() padding-left=spaceLg()
                    box height="env(safe-area-inset-bottom)" flex-shrink=0
            WriteButton(write=write, compact=compact)
        if entry.name == "thread"
          column navigationKey=`${entry.id}` navigationBar="none" position="absolute" inset=0 box-sizing="border-box"
            scroll id="conversation" testId="conversation" aria-label="Conversation" tabindex=0 flex=1 min-height=0 width="100%" overflow-y="auto" overflow-x="hidden"
              column min-height="100%"
                ThreadHeader(back=dismiss, compact=compact, measure=measureThreadHeader, mode=mode)
                column width="100%" max-width="44rem" margin="0 auto" box-sizing="border-box" padding-right=(compact ? 0 : spaceMd()) padding-left=(compact ? 0 : spaceMd()) padding-bottom=(compact ? "5rem" : "6rem")
                  column flex-shrink=0 border-left-width=(compact ? 0 : 1) border-right-width=(compact ? 0 : 1) border-bottom-width=(compact ? 0 : 1) border-left-style="solid" border-right-style="solid" border-bottom-style="solid" border-color="bd.primary" border-bottom-left-radius=(compact ? 0 : radiusFull()) border-bottom-right-radius=(compact ? 0 : radiusFull()) testId="thread-frame"
                    if visiblePosts.filter(p => p.id == entry.params.id).length == 0
                      text "Conversation not in this experience." class=WhyteSm color="tx.secondary" padding=spaceXxl() testId="thread-unavailable"
                    for focused in visiblePosts.filter(p => p.id == entry.params.id) key=focused.id
                      if focused.parent != ""
                        for parent in visiblePosts.filter(p => p.id == focused.parent) key=parent.id
                          button press=openThread(parent.id) testId="parent-thread" appearance="none" class=QuietAction scroll-margin-top=(threadHeaderHeight + spaceSm()) min-height=minTouchTarget() padding-left=spaceLg() padding-right=spaceLg() border-width=0 background-color="transparent" text-align="left"
                            text `Replying to ${parent.author}` color="tx.secondary" class=WhyteXs
                      ThreadHero(post=focused, posts=visiblePosts, reply=reply, mode=mode, context=`${entry.id}`, clearance=(threadHeaderHeight + spaceSm()))
                      ThreadReplyEntry(post=focused, reply=reply, clearance=(threadHeaderHeight + spaceSm()))
                      for child in visiblePosts.filter(p => p.parent == focused.id) key=child.id
                        ThreadBranch(post=child, posts=visiblePosts, reply=reply, open=openThread, context=`${entry.id}`, clearance=(threadHeaderHeight + spaceSm()))
                  box height="env(safe-area-inset-bottom)" flex-shrink=0
            WriteButton(write=write, compact=compact)
        if entry.name == "compose"
          column navigationKey=`${entry.id}` navigationBar="none" navigationPresentation="modal" navigationDetent="fit-content" navigationGrabber="visible" position="absolute" inset=0 background-color="experience.canvas" color="tx.primary" font-family="Whyte" padding=spaceXxl() gap=spaceXxl() box-sizing="border-box" overflow-y="auto"
            row align-items="center" justify-content="space-between" gap=spaceLg() flex-wrap="wrap"
              Button(controlId="back", label="Cancel", kind="ghost", size="medium", icon=none, disabled=pending(experienceChanged), busy=false, press=dismiss, testId="cancel")
              text (replyTo == "" ? "New post" : "Reply") role="heading" aria-level=1 font-family="Whyte Inktrap" font-weight=400 class=WhyteMd
              Button(controlId="", label="Post", kind="primary", size="medium", icon=none, disabled=(draft.trim() == "" or pending(experienceChanged)), busy=false, press=post, testId="post")
            if privateReply
              text "Private" class=WhyteXs color="tx.secondary" aria-label="Reply visibility: Private" testId="reply-private-only"
            else
              ExperienceModeControl(mode=mode, change=selectExperience, disabled=false)
            if failed(experienceChanged)
              text "Couldn’t switch experiences. Try again." class=WhyteSm color="tx.secondary" role="status"
            if replyTo != ""
              for recipient in visiblePosts.filter(p => p.id == replyTo) key=recipient.id
                column gap=spaceSm() border-left="1px solid bd.primary" padding-left=spaceMd()
                  text `Replying to ${recipient.author}` color="tx.secondary" class=WhyteXs testId="reply-recipient"
                  text recipient.body class=WhyteSm white-space="pre-wrap" line-clamp=3 testId="reply-context"
            textarea id="composer" disabled=pending(experienceChanged) value=draft input=edit placeholder=(replyTo == "" ? "What's on your mind?" : "Continue the conversation…") aria-label=(replyTo == "" ? "Write a post" : "Write a reply") testId="composer" outline="none" rows=8 min-height=224 width="100%" box-sizing="border-box" padding-top=spaceSm() padding-bottom=spaceSm() border-width=0 background-color="transparent" color="tx.primary" font-family="Whyte" class=WhyteSm resize="none"
        if entry.name == "account"
          column navigationKey=`${entry.id}` navigationBar="none" navigationPresentation="modal" navigationDetent="fit-content" navigationGrabber="visible" position="absolute" inset=0 padding=spaceXxl() gap=spaceLg() background-color="experience.canvas" color="tx.primary"
            text "David" role="heading" aria-level=1 font-family="Whyte Inktrap" font-weight=400 class=WhyteLg
            text "Sample account · design preview" color="tx.secondary"
            Button(controlId="back", label="Done", kind="ghost", size="medium", icon=none, disabled=false, busy=false, press=dismiss, testId="account-done")
