component IconButton
  params
    surfaceFill: color = "dao.bg.solid.base" control="token" group="Color" priority=1
    ink: color = "dao.ic.secondary" control="token" group="Color" priority=1
    hoverFill: color = "dao.bg.hover" control="token" group="Color" priority=2
    pressedFill: color = "dao.bg.pressed" control="token" group="Color" priority=2
  props
    kind: enum<"ghost", "surface">
    label: string
    symbol: string
    glyphSize: string
    targetSize: enum<"2.75rem", "3rem", "4rem", "44px", "48px", "64px">
    selected: option<bool>
    disabled: bool
    press: action
    testId: string
    clearance: number
  slot
  view
    if selected == none
      button appearance="none" class=Action press=press disabled=disabled aria-label=label testId=testId min-width=targetSize min-height=targetSize scroll-margin-top=clearance padding="8px" display="flex" align-items="center" justify-content="center" gap=8 color=(disabled ? "dao.ic.disabled" : (match selected { case some(v) => v, case none => false }) ? "dao.tx.control.accent" : "param.ink") background-color=((match selected { case some(v) => v, case none => false }) ? "dao.bg.accent" : kind == "surface" ? "param.surfaceFill" : "transparent") border-width=(kind == "surface" ? 1 : 0) border-style="solid" border-color="dao.bd.primary" border-radius=(kind == "surface" ? 16 : 8) cursor=(disabled ? "default" : "pointer")
        :hover
          background-color="param.hoverFill"
        :active
          background-color="param.pressedFill"
        :disabled
          background-color="transparent"
        image symbol font-size=glyphSize aria-hidden=true
        children
    else
      button appearance="none" class=Action press=press disabled=disabled aria-label=label aria-pressed=(match selected { case some(v) => v ? "true" : "false", case none => "false" }) testId=testId min-width=targetSize min-height=targetSize scroll-margin-top=clearance padding="8px" display="flex" align-items="center" justify-content="center" gap=8 color=(disabled ? "dao.ic.disabled" : (match selected { case some(v) => v, case none => false }) ? "dao.tx.control.accent" : "param.ink") background-color=((match selected { case some(v) => v, case none => false }) ? "dao.bg.accent" : kind == "surface" ? "param.surfaceFill" : "transparent") border-width=(kind == "surface" ? 1 : 0) border-style="solid" border-color="dao.bd.primary" border-radius=(kind == "surface" ? 16 : 8) cursor=(disabled ? "default" : "pointer")
        :hover
          background-color="param.hoverFill"
        :active
          background-color="param.pressedFill"
        :disabled
          background-color="transparent"
        image symbol font-size=glyphSize aria-hidden=true
        children

component FilterChip
  props
    label: string
    selected: bool
    disabled: bool
    press: action
    testId: string
  view
    button appearance="none" class=Action aria-pressed=selected disabled=disabled press=press testId=testId min-height="2.75rem" padding="6px 12px" border="1px solid dao.bd.primary" border-radius=32 color=(disabled ? "dao.tx.disabled" : selected ? "dao.tx.control.accent" : "dao.tx.primary") background-color=(selected ? "dao.bg.accent" : "transparent") cursor=(disabled ? "default" : "pointer")
      :hover
        background-color="dao.bg.hover"
      :active
        background-color="dao.bg.pressed"
      :disabled
        background-color="transparent"
      text label
