component Button
  params
    primaryFill: color = "dao.bg.solid.button" control="token" group="Color" priority=1
    primaryHover: color = "dao.bg.solid.button-hover" control="token" group="Color" priority=2
    primaryPressed: color = "dao.bg.solid.button-pressed" control="token" group="Color" priority=2
    primaryDisabled: color = "dao.bg.solid.button-disabled" control="token" group="Color" priority=2
    primaryInk: color = "dao.tx.button" control="token" group="Color" priority=1
  props
    label: string
    kind: enum<"primary", "secondary", "tertiary", "ghost", "accentGhost", "destructive", "success", "warning", "accent", "accentLight", "warningLight", "successLight", "errorLight">
    size: enum<"small", "medium", "large", "xl">
    disabled: bool
    busy: bool
    press: action
    testId: string
  view
    if kind == "primary"
      button appearance="none" class=ActionPrimary press=press disabled=(disabled or busy) aria-label=label aria-busy=busy testId=testId min-height=actionTarget(size) font-family=(size == "xl" ? "Whyte Inktrap" : "Whyte") font-size=(size == "small" ? "0.8125rem" : size == "xl" ? "1.25rem" : "1rem") line-height=(size == "small" ? "1rem" : size == "xl" ? "2rem" : "1.5rem") cursor=((disabled or busy) ? "default" : "pointer")
        text (busy ? `${label}…` : label)
    else if kind == "secondary"
      button appearance="none" class=ActionSecondary press=press disabled=(disabled or busy) aria-label=label aria-busy=busy testId=testId min-height=actionTarget(size) font-family=(size == "xl" ? "Whyte Inktrap" : "Whyte") font-size=(size == "small" ? "0.8125rem" : size == "xl" ? "1.25rem" : "1rem") line-height=(size == "small" ? "1rem" : size == "xl" ? "2rem" : "1.5rem") cursor=((disabled or busy) ? "default" : "pointer")
        text (busy ? `${label}…` : label)
    else if kind == "tertiary"
      button appearance="none" class=ActionTertiary press=press disabled=(disabled or busy) aria-label=label aria-busy=busy testId=testId min-height=actionTarget(size) font-family=(size == "xl" ? "Whyte Inktrap" : "Whyte") font-size=(size == "small" ? "0.8125rem" : size == "xl" ? "1.25rem" : "1rem") line-height=(size == "small" ? "1rem" : size == "xl" ? "2rem" : "1.5rem") cursor=((disabled or busy) ? "default" : "pointer")
        text (busy ? `${label}…` : label)
    else if kind == "ghost"
      button appearance="none" class=ActionGhost press=press disabled=(disabled or busy) aria-label=label aria-busy=busy testId=testId min-height=actionTarget(size) font-family=(size == "xl" ? "Whyte Inktrap" : "Whyte") font-size=(size == "small" ? "0.8125rem" : size == "xl" ? "1.25rem" : "1rem") line-height=(size == "small" ? "1rem" : size == "xl" ? "2rem" : "1.5rem") cursor=((disabled or busy) ? "default" : "pointer")
        text (busy ? `${label}…` : label)
    else if kind == "accentGhost"
      button appearance="none" class=ActionAccentGhost press=press disabled=(disabled or busy) aria-label=label aria-busy=busy testId=testId min-height=actionTarget(size) font-family=(size == "xl" ? "Whyte Inktrap" : "Whyte") font-size=(size == "small" ? "0.8125rem" : size == "xl" ? "1.25rem" : "1rem") line-height=(size == "small" ? "1rem" : size == "xl" ? "2rem" : "1.5rem") cursor=((disabled or busy) ? "default" : "pointer")
        text (busy ? `${label}…` : label)
    else if kind == "destructive"
      button appearance="none" class=ActionDestructive press=press disabled=(disabled or busy) aria-label=label aria-busy=busy testId=testId min-height=actionTarget(size) font-family=(size == "xl" ? "Whyte Inktrap" : "Whyte") font-size=(size == "small" ? "0.8125rem" : size == "xl" ? "1.25rem" : "1rem") line-height=(size == "small" ? "1rem" : size == "xl" ? "2rem" : "1.5rem") cursor=((disabled or busy) ? "default" : "pointer")
        text (busy ? `${label}…` : label)
    else if kind == "success"
      button appearance="none" class=ActionSuccess press=press disabled=(disabled or busy) aria-label=label aria-busy=busy testId=testId min-height=actionTarget(size) font-family=(size == "xl" ? "Whyte Inktrap" : "Whyte") font-size=(size == "small" ? "0.8125rem" : size == "xl" ? "1.25rem" : "1rem") line-height=(size == "small" ? "1rem" : size == "xl" ? "2rem" : "1.5rem") cursor=((disabled or busy) ? "default" : "pointer")
        text (busy ? `${label}…` : label)
    else if kind == "warning"
