// Exact actions: shared intent with literal host-owned interaction states.
fn actionTarget(size: string): string = size == "xl" ? "3.5rem" : size == "large" ? "3rem" : "2.75rem"

style Action
  font-family = "Whyte"
  font-size = "1rem"
  line-height = "1.5rem"
  cursor = "pointer"
  box-sizing = "border-box"
  border-width = 0
  border-radius = 8
  white-space = "normal"
  max-width = "100%"
  :focus-visible
    box-shadow = "0 0 0 2px dao.focus"
  :hover
    background-color = "dao.bg.hover"
  :active
    background-color = "dao.bg.pressed"

style ActionPrimary
  font-family = "Whyte"
  font-size = "1rem"
  line-height = "1.5rem"
  cursor = "pointer"
  box-sizing = "border-box"
  border-width = 0
  border-radius = 8
  white-space = "normal"
  max-width = "100%"
  :focus-visible
    box-shadow = "0 0 0 2px dao.focus"
  background-color = "param.primaryFill"
  color = "param.primaryInk"
  padding = "8px 20px"
  :hover
    background-color = "param.primaryHover"
  :active
    background-color = "param.primaryPressed"
  :disabled
    background-color = "param.primaryDisabled"
    color = "dao.tx.disabled"
    opacity = 0.6

