fresh
epoch now
size 390x844

test "main tabs own writing context and restore separate drafts"
  fail fetch "https://public.api.bsky.app/"
  type "handle" "owner.test"
  clock data
  tap "login"
  authorize
  clock settle
  expect text "header-experience-private" == "Personal"
  expect text "header-experience-public" == "Public"
  expect state mode == "bluesky"
  tap "header-experience-private"
  clock settle
  expect state mode == "private"
  screenshot ".exact/views-personal-narrow.png"
  tap "feed-write"
  clock settle
  expect text "reply-private-only" == "Personal"
  expect tree missing "experience-control"
  type "composer" "My personal draft ♍︎"
  tap "cancel"
  clock settle
  tap "header-experience-public"
  clock settle
  expect state mode == "public"
  tap "feed-write"
  clock settle
  expect text "composer" == ""
  expect text "writing-public" == "Public · Jera"
  type "composer" "My public draft"
  tap "cancel"
  clock settle
  tap "header-experience-private"
  clock settle
  tap "feed-write"
  clock settle
  expect text "composer" == "My personal draft ♍︎"
  tap "cancel"
  clock settle
  tap "header-experience-public"
  clock settle
  tap "feed-write"
  clock settle
  expect text "composer" == "My public draft"
  tap "cancel"
  clock settle
  reload
  clock settle
  expect state mode == "public"
  resize 1100x850
  screenshot ".exact/views-public-wide.png"
  type "header-experience-public" key "ArrowRight"
  clock settle
  expect state mode == "private"
  screenshot ".exact/views-personal-wide.png"
  tap "feed-write"
  clock settle
  expect text "composer" == "My personal draft ♍︎"

test "Bluesky opens first, restores its private draft and posts with explicit consent"
  fail fetch "https://public.api.bsky.app/"
  type "handle" "owner.test"
  clock data
  tap "login"
  authorize
  clock settle
  expect state mode == "bluesky"
  expect tree missing "feed-write"
  expect text "sky-count" == "0 / 300"
  type "sky-composer" "A public thought ♍︎"
  clock settle
  reload
  clock settle
  expect text "sky-composer" == "A public thought ♍︎"
  expect text "sky-count" == "18 / 300"
  tap "sky-enable"
  authorize
  clock settle
  type "sky-composer" "👩🏽‍💻"
  clock settle
  expect text "sky-count" == "301 / 300"
  expect disabled "sky-post"
  type "sky-composer" "👩🏽‍💻aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  clock settle
  expect text "sky-count" == "300 / 300"
  expect enabled "sky-post"
  type "sky-composer" "A public thought ♍︎"
  clock settle
  expect enabled "sky-post"
  expect state skyPosts.length == 0
  tap "sky-post"
  clock settle
  expect state skyPosts.length == 1
  expect state skyPosts.0 .text == "A public thought ♍︎"
  expect text "sky-composer" == ""
  expect text "sky-count" == "0 / 300"
  screenshot ".exact/bluesky-posted.png"
  reload
  clock settle
  expect state skyPosts.length == 1
  expect text "sky-composer" == ""
  tap "header-experience-public"
  clock settle
  expect state feedPosts.length == 0
