fresh
epoch now

test "a real stored post and draft survive relaunch"
  fail fetch "https://public.api.bsky.app/"
  type "handle" "owner.test"
  clock data
  tap "login"
  authorize
  clock settle
  tap "feed-write"
  clock settle
  type "composer" "A durable thought ♍︎ ♍️ :virgo:"
  clock settle
  tap "cancel"
  clock settle
  reload
  clock settle
  tap "feed-write"
  clock settle
  expect text "composer" == "A durable thought ♍︎ ♍️ :virgo:"
  tap "post"
  clock settle
  expect state posts.length == 1
  expect state posts.0 .body == "A durable thought ♍︎ ♍️ :virgo:"
  expect state posts.0 .visibility == "private"
  expect state editorText == "A durable thought ♍︎ ♍️ :virgo:"
  tap "write"
  clock settle
  expect text "composer" == ""
  type "composer" "An unposted next thought"
  tap "cancel"
  clock settle
  tap "write"
  clock settle
  expect text "composer" == "An unposted next thought"
  tap "cancel"
  clock settle
  tap "reply"
  clock settle
  expect tree has "reply-private-only"
  expect tree missing "experience-public"
  type "composer" "A stored private reply"
  clock settle
  tap "post"
  clock settle
  expect state posts.length == 2
  expect state posts.1 .body == "A stored private reply"
  reload
  clock settle
  expect state posts.length == 2
  expect state posts.0 .body == "A durable thought ♍︎ ♍️ :virgo:"

test "Public reads historical Snapback posts and supports new posts and replies"
  request POST "/dev/legacy-public" {}
  fail fetch "https://public.api.bsky.app/"
  type "handle" "owner.test"
  clock data
  tap "login"
  authorize
  clock settle
  tap "header-experience-public"
  clock settle
  expect state feedPosts.length == 1
  expect state feedPosts.0 .body == "An earlier public Snapback post"
  screenshot ".exact/snapback-public-history.png"
  expect tree missing "public-feed-title"
  expect tree has "feed-write"
  tap "feed-write"
  clock settle
  expect tree has "writing-public"
  type "composer" "New public Snapback post ♍︎ ♍️"
  screenshot ".exact/snapback-public-composer.png"
  tap "post"
  clock settle
  expect state published.message == ""
  expect state posts.length == 2
  expect state posts.1 .visibility == "public"
  tap "reply"
  clock settle
  type "composer" "A public reply"
  tap "post"
  clock settle
  expect state posts.length == 3
  expect state posts.2 .visibility == "public"
  reload
  clock settle
  expect state posts.length == 3
  tap "back"
  clock settle
  tap "header-experience-private"
  clock settle
  expect state feedPosts.length == 0
  tap "feed-write"
  clock settle
  type "composer" "A private post stays private"
  tap "post"
  clock settle
  tap "back"
  clock settle
  tap "header-experience-public"
  clock settle
  expect state feedPosts.length == 2
  expect state visiblePosts.length == 3

test "a private audience grants and revokes DID access through the real store"
  fail fetch "https://public.api.bsky.app/"
  type "handle" "owner.test"
  clock data
  tap "login"
  authorize
  clock settle
  tap "account-avatar"
  clock settle
  tap "private-audience"
  clock settle
  type "audience-did" "did:plc:bbbbbbbbbbbbbbbbbbbbbbbb"
  tap "audience-add"
  clock settle
  expect tree has "audience-member-did:plc:bbbbbbbbbbbbbbbbbbbbbbbb"
  reload
  clock settle
  expect tree has "audience-member-did:plc:bbbbbbbbbbbbbbbbbbbbbbbb"
  tap "audience-remove-did:plc:bbbbbbbbbbbbbbbbbbbbbbbb"
  clock settle
  expect tree missing "audience-member-did:plc:bbbbbbbbbbbbbbbbbbbbbbbb"
