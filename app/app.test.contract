fresh
epoch now

// OAuth is a fixture here; authorization acceptance requires a real PDS.
test "account sheet opens, dismisses and logs out without losing the quiet home"
  fail fetch "https://public.api.bsky.app/"
  expect disabled "login"
  type "handle" "owner..test"
  clock data
  expect disabled "login"
  type "handle" "own"
  clock +300
  clock data
  expect disabled "login"
  expect tree has "suggestion-0"
  type "handle" key "Escape"
  clock settle
  expect state accountsOpen == false
  type "handle" "owne"
  clock +300
  clock data
  type "handle" key "ArrowDown"
  type "suggestion-0" key "Enter"
  expect text "handle" == "owner.test"
  clock data
  expect enabled "login"
  expect tree missing "account-did"
  expect tree missing "suggestion-0"
  tap "login"
  authorize
  clock data
  expect state account.principal == "did:plc:aaaaaaaaaaaaaaaaaaaaaaaa"
  expect tree has "jera-wordmark"
  expect tree missing "handle"
  expect tree missing "account-did"
  expect tree missing "refresh"
  expect tree missing "arm-name"
  expect tree missing "account-loading"
  clock +15000
  clock data
  expect state account.principal == "did:plc:aaaaaaaaaaaaaaaaaaaaaaaa"
  expect tree has "jera-wordmark"
  expect tree missing "account-loading"
  reload
  clock data
  expect state account.principal == "did:plc:aaaaaaaaaaaaaaaaaaaaaaaa"
  expect tree has "jera-wordmark"
  expect tree missing "handle"
  expect tree missing "refresh"
  expect tree has "account-avatar"
  tap "account-avatar"
  clock settle
  expect text "profile-name" == "Your account"
  back
  clock settle
  tap "account-avatar"
  clock settle
  tap "logout"
  clock data
  expect state account.principal == ""
  expect tree has "handle"
  expect tree missing "account-avatar"

test "offline session restoration and logout keep account controls usable"
  fail fetch "https://public.api.bsky.app/"
  type "handle" "offline.test"
  tap "login"
  authorize
  clock data
  expect tree missing "handle"
  fail fetch "backend"
  reload
  clock data
  expect tree has "jera-wordmark"
  expect tree missing "handle"
  expect tree missing "account-loading"
  expect tree missing "retry-account"
  expect tree missing "refresh"
  clock +15000
  clock data
  expect tree missing "handle"
  expect tree missing "account-loading"
  tap "account-avatar"
  clock settle
  tap "logout"
  clock data
  expect state account.principal == ""
  expect tree has "handle"
  expect tree missing "account-avatar"

// A separate fixture launch: Exact's web route changes discard authFixture,
// so its held-auth driver cannot authorize again after navigating. Real popup
// account switching is checked separately; do not add fixture logic to the app.
test "account panel on a wider viewport"
  size 1024x768
  fail fetch "https://public.api.bsky.app/"
  type "handle" "other.test"
  tap "login"
  authorize
  clock data
  tap "account-avatar"
  clock settle
  expect text "profile-name" == "Your account"
  expect tree has "logout"
